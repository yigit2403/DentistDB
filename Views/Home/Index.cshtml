@model DentistDB.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Kontrol Paneli";
    var todayIso = Model.Today.ToString("yyyy-MM-dd");
    var returnUrl = Url.Action("Index", "Home");
}

<div class="page-header">
    <div>
        <h2 class="page-title">@Model.Today.ToDayHeading()</h2>
        <p class="page-subtitle">
            Bugün @Model.TodaysAppointments.Count randevu var
            @if (Model.TodaysAppointments.Count > 0)
            {
                <text>· @Model.TodayCompleted tamamlandı · @Model.TodayRemaining bekliyor</text>
            }
        </p>
    </div>
    <div class="page-actions">
        <a asp-controller="Appointments" asp-action="PrintDay" asp-route-date="@todayIso" target="_blank" class="btn btn-outline-secondary" title="Bugünün listesini yazdır"><svg class="icon" aria-hidden="true"><use href="#i-print"/></svg> Günlük Liste</a>
        @if (Model.ShowFinancials)
        {
            <a asp-controller="Billing" asp-action="DailyReport" class="btn btn-outline-secondary"><svg class="icon" aria-hidden="true"><use href="#i-coins"/></svg> Gün Sonu</a>
        }
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary"><svg class="icon" aria-hidden="true"><use href="#i-calendar-plus"/></svg> Randevu Ekle</a>
        <a asp-controller="Patients" asp-action="Create" class="btn btn-outline-secondary"><svg class="icon" aria-hidden="true"><use href="#i-user-plus"/></svg> Yeni Hasta</a>
    </div>
</div>

@*
    Desktop: stats span the top, today's list sits under them on the left, the side cards on the right.
    Phone: DOM order wins, so today's appointments come first and the stats collapse into a compact 2-column strip.
*@
<div class="dash">
    <div class="dash-today">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Bugünün Randevuları</h3>
                <a asp-controller="Appointments" asp-action="Index" asp-route-date="@todayIso" class="btn btn-sm btn-outline-secondary">Ajandayı Aç</a>
            </div>
            @if (!Model.TodaysAppointments.Any())
            {
                <div class="empty-state">
                    <svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg>
                    <p>Bugün için planlanmış randevu yok.</p>
                    <a asp-controller="Appointments" asp-action="Create" class="btn btn-sm btn-primary">Randevu Ekle</a>
                </div>
            }
            else
            {
                <ul class="list">
                    @foreach (var appt in Model.TodaysAppointments)
                    {
                        var done = appt.Status != AppointmentStatus.Scheduled;
                        <li class="list-item @(done ? "is-done" : "")">
                            <span class="time">@appt.AppointmentDate.ToTimeText()</span>
                            <div class="grow">
                                <div class="title">
                                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@appt.PatientId" class="row-link">@appt.Patient?.FullName</a>
                                    @if (appt.Patient?.HasMedicalRisk == true)
                                    {
                                        <span class="badge-soft danger ms-1" title="@string.Join(", ", appt.Patient.RiskFlags.Prepend(appt.Patient.MedicalAlerts ?? "").Where(x => x != ""))">Uyarı</span>
                                    }
                                </div>
                                <div class="meta">@appt.Purpose · @appt.DurationMinutes.ToDurationText()@(appt.Status != AppointmentStatus.Scheduled ? $" · {appt.Status.GetDisplayName()}" : "")</div>
                            </div>
                            <div class="actions">
                                @if (appt.Status == AppointmentStatus.Scheduled)
                                {
                                    <form asp-controller="Appointments" asp-action="SetStatus" asp-route-id="@appt.Id" asp-route-status="Completed" asp-route-returnUrl="@returnUrl" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Tamamlandı" aria-label="Tamamlandı olarak işaretle"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg></button>
                                    </form>
                                    <form asp-controller="Appointments" asp-action="SetStatus" asp-route-id="@appt.Id" asp-route-status="NoShow" asp-route-returnUrl="@returnUrl" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Gelmedi" aria-label="Gelmedi olarak işaretle"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
                                    </form>
                                }
                                @if (appt.Status == AppointmentStatus.Completed)
                                {
                                    <partial name="~/Views/Appointments/_FollowUpMenu.cshtml" model="appt" view-data='new ViewDataDictionary(ViewData) { { "ReturnUrl", returnUrl } }' />
                                }
                                <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appt.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="Randevuyu düzenle"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="stat-grid dash-stats">
        <div class="stat">
            <span class="stat-label">Aktif Hasta</span>
            <span class="stat-value">@Model.TotalPatients</span>
            <span class="stat-hint">Bu ay @Model.NewPatientsThisMonth yeni kayıt</span>
        </div>
        <div class="stat">
            <span class="stat-label">Bu Hafta</span>
            <span class="stat-value">@Model.AppointmentsThisWeek</span>
            <span class="stat-hint">randevu</span>
        </div>
        <div class="stat">
            <span class="stat-label">Bu Ay</span>
            <span class="stat-value">@Model.AppointmentsThisMonth</span>
            <span class="stat-hint">randevu</span>
        </div>
        @if (Model.ShowFinancials)
        {
            <div class="stat @(Model.OutstandingBalance > 0 ? "stat-warn" : "")">
                <span class="stat-label">Bekleyen Alacak</span>
                <span class="stat-value money">@Model.OutstandingBalance.ToMoney()</span>
                <span class="stat-hint">@Model.OverdueInvoices.Count vadesi geçmiş fatura</span>
            </div>
            <div class="stat stat-success">
                <span class="stat-label">Bu Ay Tahsilat</span>
                <span class="stat-value money">@Model.CollectedThisMonth.ToMoney()</span>
                <span class="stat-hint">@Model.Today.ToMonthHeading()</span>
            </div>
        }
    </div>

    <div class="dash-left">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Yaklaşan Randevular</h3>
                <a asp-controller="Appointments" asp-action="Index" asp-route-view="Weekly" class="btn btn-sm btn-outline-secondary">Haftalık Görünüm</a>
            </div>
            @if (!Model.UpcomingAppointments.Any())
            {
                <div class="empty-state"><p>Önümüzdeki 7 gün için randevu yok.</p></div>
            }
            else
            {
                <ul class="list">
                    @foreach (var appt in Model.UpcomingAppointments)
                    {
                        <li class="list-item">
                            <span class="time" style="min-width:96px">@appt.AppointmentDate.ToString("dd MMM ddd") <br /><span class="text-muted small">@appt.AppointmentDate.ToTimeText()</span></span>
                            <div class="grow">
                                <div class="title"><a asp-controller="Patients" asp-action="Details" asp-route-id="@appt.PatientId" class="row-link">@appt.Patient?.FullName</a></div>
                                <div class="meta">@appt.Purpose</div>
                            </div>
                            <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appt.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="Randevuyu düzenle"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="dash-right">
        @if (Model.ShowFinancials)
        {
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Yaklaşan Taksitler</h3>
                    <a asp-controller="Billing" asp-action="Index" class="btn btn-sm btn-outline-secondary">Faturalar</a>
                </div>
                @if (!Model.DuePaymentPlanItems.Any())
                {
                    <div class="empty-state"><p>Önümüzdeki 14 gün içinde vadesi gelen taksit yok.</p></div>
                }
                else
                {
                    <ul class="list">
                        @foreach (var item in Model.DuePaymentPlanItems)
                        {
                            <li class="list-item">
                                <div class="grow">
                                    <div class="title"><a asp-controller="Billing" asp-action="Details" asp-route-id="@item.InvoiceId" class="row-link">@item.Invoice?.Patient?.FullName</a></div>
                                    <div class="meta">@item.InstallmentNumber. taksit · @item.PaymentDate.ToShortDate() @(item.IsOverdue ? "· gecikmiş" : "")</div>
                                </div>
                                <span class="badge-soft @(item.IsOverdue ? "danger" : "warning") money">@item.Amount.ToMoney()</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (Model.OverdueInvoices.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Vadesi Geçmiş Faturalar</h3>
                        <a asp-controller="Billing" asp-action="Index" asp-route-overdue="true" class="btn btn-sm btn-outline-secondary">Tümü</a>
                    </div>
                    <ul class="list">
                        @foreach (var inv in Model.OverdueInvoices)
                        {
                            <li class="list-item">
                                <div class="grow">
                                    <div class="title"><a asp-controller="Billing" asp-action="Details" asp-route-id="@inv.Id" class="row-link">@inv.Patient?.FullName</a></div>
                                    <div class="meta">Fatura #@inv.Id · vade @inv.DueDate.ToShortDate()</div>
                                </div>
                                <span class="badge-soft danger money">@inv.Balance.ToMoney()</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Son Eklenen Hastalar</h3>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-sm btn-outline-secondary">Hasta Listesi</a>
            </div>
            @if (!Model.RecentPatients.Any())
            {
                <div class="empty-state"><p>Henüz hasta kaydı yok.</p></div>
            }
            else
            {
                <ul class="list">
                    @foreach (var patient in Model.RecentPatients)
                    {
                        <li class="list-item">
                            <partial name="_Avatar" model="new AvatarModel(patient.Id, patient.FullName, patient.PhotoContentType != null)" />
                            <div class="grow">
                                <div class="title">
                                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id" class="row-link">@patient.FullName</a>
                                    @if (patient.HasMedicalRisk)
                                    {
                                        <span class="badge-soft danger ms-1">Tıbbi Uyarı</span>
                                    }
                                </div>
                                <div class="meta">@(patient.Phone.FormatPhone() ?? "Telefon yok")</div>
                            </div>
                            <span class="text-muted small">@patient.CreatedAt.ToLocalTime().ToShortDate()</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Son Tedaviler</h3>
                <a asp-controller="PreviousOperations" asp-action="Index" class="btn btn-sm btn-outline-secondary">Tümü</a>
            </div>
            @if (!Model.RecentOperations.Any())
            {
                <div class="empty-state"><p>Henüz tedavi kaydı yok.</p></div>
            }
            else
            {
                <ul class="list">
                    @foreach (var op in Model.RecentOperations)
                    {
                        var teeth = TeethSelectionSerializer.Parse(op.SelectedTeethData);
                        <li class="list-item">
                            <div class="grow">
                                <div class="title">@op.Title</div>
                                <div class="meta"><a asp-controller="Patients" asp-action="Details" asp-route-id="@op.PatientId" asp-route-tab="treatments">@op.Patient?.FullName</a> · @op.Date.ToShortDate()</div>
                            </div>
                            @if (teeth.Any())
                            {
                                <span class="tooth-chips">@foreach (var t in teeth) { <span class="tooth-chip">@t</span> }</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
