@model DentistDB.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Kontrol Paneli";
    var canViewFinancials = Context.CanViewFinancials();
}

<section class="hero-panel glass-card">
    <div class="page-header mb-0">
        <div>
            <div class="eyebrow">Günlük Operasyon Özeti</div>
            <h2 class="page-title">Kliniğin bugünkü akışını tek bakışta yönetin.</h2>
            <p class="page-subtitle">@DateTime.Today.ToString("D") tarihli plan, tahsilat ve hasta hareketleri burada toplanır.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-light">Randevu Ekle</a>
            <a asp-controller="Patients" asp-action="Create" class="btn btn-outline-light">Yeni Hasta</a>
        </div>
    </div>
</section>

<section class="metric-grid mb-4">
    <article class="stats-card glass-card">
        <div class="label">Aktif Hasta</div>
        <div class="value">@Model.TotalPatients</div>
        <div class="page-subtitle">Güncel hasta havuzu</div>
    </article>
    <article class="stats-card glass-card">
        <div class="label">Bugünkü Randevu</div>
        <div class="value">@Model.TodaysAppointments.Count</div>
        <div class="page-subtitle">Bugün beklenen ziyaret</div>
    </article>
    <article class="stats-card glass-card">
        <div class="label">Aylık Randevu</div>
        <div class="value">@Model.AppointmentsThisMonth</div>
        <div class="page-subtitle">Bu ay içindeki toplam plan</div>
    </article>
    <article class="stats-card glass-card">
        <div class="label">Açık Fatura</div>
        <div class="value">@Model.UnpaidInvoices.Count</div>
        <div class="page-subtitle">Takip edilmesi gereken tahsilat</div>
    </article>
</section>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="section-title">Bugünkü Randevular</h3>
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-sm btn-outline-primary">Yeni</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.TodaysAppointments.Any())
                {
                    <p class="empty-state mb-0">Bugün için planlı randevu bulunmuyor.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var appt in Model.TodaysAppointments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@appt.AppointmentDate.ToString("t")</div>
                                    <div>@appt.Patient?.FullName</div>
                                    <div class="text-muted small">@appt.Purpose</div>
                                </div>
                                <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appt.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="section-title">Sıradaki 7 Gün</h3>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.UpcomingAppointments.Any())
                {
                    <p class="empty-state mb-0">Yaklaşan randevu bulunmuyor.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var appt in Model.UpcomingAppointments)
                        {
                            <li class="list-group-item">
                                <div class="fw-semibold">@appt.AppointmentDate.ToString("dd MMMM, HH:mm")</div>
                                <div>@appt.Patient?.FullName</div>
                                <div class="text-muted small">@appt.Purpose</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="section-title">Son Eklenen Hastalar</h3>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-sm btn-outline-secondary">Listeye Git</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentPatients.Any())
                {
                    <p class="empty-state mb-0">Henüz hasta kaydı bulunmuyor.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var patient in Model.RecentPatients)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@patient.Id" class="text-decoration-none fw-semibold">@patient.FullName</a>
                                    @if (!string.IsNullOrEmpty(patient.MedicalAlerts))
                                    {
                                        <span class="badge-soft danger ms-2">Tıbbi Uyarı</span>
                                    }
                                    <div class="text-muted small">@patient.Phone</div>
                                </div>
                                <span class="text-muted small">@patient.CreatedAt.ToString("dd MMM")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="section-title">Açık Faturalar</h3>
                <a asp-controller="Billing" asp-action="Index" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.UnpaidInvoices.Any())
                {
                    <p class="empty-state mb-0">Bekleyen fatura bulunmuyor.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var inv in Model.UnpaidInvoices)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="Billing" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none fw-semibold">@inv.Patient?.FullName</a>
                                    <div class="text-muted small">Vade: @inv.DueDate?.ToString("D")</div>
                                </div>
                                @if (canViewFinancials)
                                {
                                    <span class="badge-soft danger">@inv.Balance.ToString("C")</span>
                                }
                                else
                                {
                                    <span class="badge-soft warning">@inv.Status.GetDisplayName()</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
