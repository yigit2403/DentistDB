@model DentistDB.ViewModels.PreviousOperationsIndexViewModel
@{
    ViewData["Title"] = "Tedavi Kayıtları";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var list = Model.Operations;
}

<div class="page-header">
    <div>
        @if (Model.Patient != null)
        {
            <div class="topbar-crumb"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.Patient.Id">@Model.Patient.FullName</a> / Tedaviler</div>
        }
        <h2 class="page-title">Tedavi Kayıtları</h2>
        <p class="page-subtitle">@list.TotalCount kayıt</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" asp-route-patientId="@Model.PatientId" asp-route-returnUrl="@currentUrl" class="btn btn-primary"><svg class="icon"><use href="#i-plus"/></svg> Tedavi Kaydı</a>
    </div>
</div>

<div class="card">
    <div class="card-body py-3">
        <form method="get" class="filter-bar">
            @if (Model.PatientId.HasValue)
            {
                <input type="hidden" name="patientId" value="@Model.PatientId" />
            }
            <div class="quick-search" style="width:min(460px,100%)">
                <svg class="icon"><use href="#i-search"/></svg>
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Hasta, tanı, işlem, diş numarası…" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Ara</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a asp-action="Index" asp-route-patientId="@Model.PatientId" class="btn btn-ghost">Temizle</a>
            }
        </form>
    </div>
</div>

@if (!list.Any())
{
    <div class="card"><div class="empty-state"><svg class="icon"><use href="#i-clipboard"/></svg><p>Bu filtreye uygun tedavi kaydı yok.</p></div></div>
}
else
{
    foreach (var op in list)
    {
        <partial name="_OperationCard" model="op" view-data='new ViewDataDictionary(ViewData) { { "ReturnUrl", currentUrl }, { "ShowPatient", Model.Patient == null } }' />
    }

    <div class="card mt-3">
        <partial name="_Pagination" model="new PaginationViewModel
        {
            PageIndex = list.PageIndex,
            TotalPages = list.TotalPages,
            TotalCount = list.TotalCount,
            PageSize = list.PageSize,
            FirstItemNumber = list.FirstItemNumber,
            LastItemNumber = list.LastItemNumber
        }" />
    </div>
}
