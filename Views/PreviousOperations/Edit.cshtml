@model DentistDB.ViewModels.PreviousOperationFormViewModel
@{
    ViewData["Title"] = "Tedavi Kaydını Düzenle";
    var cancelUrl = Model.ReturnUrl ?? Url.Action("Details", "Patients", new { id = Model.PatientId, tab = "treatments" });
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index">Tedavi Kayıtları</a> / Düzenle</div>
        <h2 class="page-title">Tedavi Kaydını Düzenle@(Model.PatientName != null ? $" · {Model.PatientName}" : "")</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_OperationForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Değişiklikleri Kaydet</button>
                <a href="@cancelUrl" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
