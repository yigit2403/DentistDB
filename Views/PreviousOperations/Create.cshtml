@model DentistDB.ViewModels.PreviousOperationFormViewModel
@{
    ViewData["Title"] = "Yeni Tedavi Kaydı";
    var cancelUrl = Model.ReturnUrl ?? (Model.PatientId > 0 ? Url.Action("Details", "Patients", new { id = Model.PatientId, tab = "treatments" }) : Url.Action("Index"));
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index">Tedavi Kayıtları</a> / Yeni</div>
        <h2 class="page-title">Yeni Tedavi Kaydı@(Model.PatientName != null ? $" · {Model.PatientName}" : "")</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_OperationForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Kaydı Oluştur</button>
                <a href="@cancelUrl" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
