@model DentistDB.ViewModels.PreviousOperationFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="PatientId" class="form-label">Hasta <span class="req">*</span></label>
                <select asp-for="PatientId" asp-items="Model.Patients" class="form-select">
                    <option value="">Hasta seçin…</option>
                </select>
                <span asp-validation-for="PatientId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Date" class="form-label">Tarih <span class="req">*</span></label>
                <input asp-for="Date" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Title" class="form-label">İşlem Başlığı <span class="req">*</span></label>
                <input asp-for="Title" class="form-control" list="title-options" autocomplete="off" placeholder="Örn. Kanal tedavisi" />
                <datalist id="title-options">
                    @foreach (var s in Model.TitleSuggestions)
                    {
                        <option value="@s"></option>
                    }
                </datalist>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Diagnosis" class="form-label"></label>
                <textarea asp-for="Diagnosis" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Diagnosis" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Procedures" class="form-label"></label>
                <textarea asp-for="Procedures" class="form-control" rows="3" placeholder="Yapılan işlemleri adım adım yazabilirsiniz"></textarea>
                <span asp-validation-for="Procedures" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Prescriptions" class="form-label"></label>
                <textarea asp-for="Prescriptions" class="form-control" rows="2" placeholder="İlaç, doz, kullanım"></textarea>
                <span asp-validation-for="Prescriptions" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <partial name="_ToothSelector" model='new ToothSelectorViewModel { Label = "Tedavi Edilen Dişler", SelectedTeethCsv = Model.SelectedTeeth ?? string.Empty }' />
    </div>
</div>
