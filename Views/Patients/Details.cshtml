@model DentistDB.Models.Patient
@{
    ViewData["Title"] = Model.FullName;
    var canViewFinancials = Context.CanViewFinancials();
}

<div class="page-header">
    <div>
        <div class="eyebrow">Hasta Dosyası</div>
        <h2 class="page-title">@Model.FullName</h2>
        <p class="page-subtitle">
            Kayıt tarihi @Model.CreatedAt.ToString("MMMM yyyy")
            <span class="badge-soft @(Model.IsArchived ? "neutral" : "success") ms-2">@(Model.IsArchived ? "Arşivde" : "Aktif")</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
        <a asp-controller="PreviousOperations" asp-action="Index" asp-route-patientId="@Model.Id" class="btn btn-outline-secondary">Önceki İşlemler</a>
        @if (!Model.IsArchived)
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu hastayı arşive taşımak istiyor musunuz?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Arşivle</button>
            </form>
        }
        else
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Geri Yükle</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MedicalAlerts))
{
    <div class="alert alert-danger">
        <strong>Tıbbi Uyarılar:</strong> @Model.MedicalAlerts
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">İletişim Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Doğum Tarihi</dt>
                    <dd class="col-sm-8">@(Model.BirthDate?.ToString("D") ?? "-")</dd>
                    <dt class="col-sm-4">Adres</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Klinik Notlar</h3></div>
            <div class="card-body">
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Bu hasta için not eklenmemiş." : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="section-title">Randevular</h3>
        <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Yeni Randevu</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Appointments.Any())
        {
            <p class="empty-state mb-0">Bu hastaya ait randevu bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Konu</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            var selectedTeeth = TreatmentRecordTeethSerializer.ParseSelectedTeeth(appt.Notes);
                            var cleanNotes = TreatmentRecordTeethSerializer.StripMetadata(appt.Notes);
                            <tr>
                                <td>@appt.AppointmentDate.ToString("f")</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(appt.Purpose) ? "Belirtilmedi" : appt.Purpose)
                                    @if (selectedTeeth.Any())
                                    {
                                        <div class="operation-teeth mt-2">
                                            @foreach (var tooth in selectedTeeth)
                                            {
                                                <span class="badge-soft info">@tooth</span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(cleanNotes))
                                    {
                                        <div class="text-muted small mt-1">@cleanNotes</div>
                                    }
                                </td>
                                <td><span class="badge-soft @(appt.Status == AppointmentStatus.Completed ? "success" : appt.Status == AppointmentStatus.Cancelled ? "neutral" : appt.Status == AppointmentStatus.NoShow ? "warning" : "info")">@appt.Status.GetDisplayName()</span></td>
                                <td class="text-end">
                                    <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appt.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="section-title">Görüntüler ve Taramalar</h3>
        <a asp-controller="Scans" asp-action="Upload" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Tarama Yükle</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Scans.Any())
        {
            <p class="empty-state mb-0">Yüklenmiş tarama bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Dosya</th>
                            <th>Tür</th>
                            <th>Boyut</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scan in Model.Scans)
                        {
                            <tr>
                                <td>@scan.ScanDate.ToString("d")</td>
                                <td>@scan.FileName</td>
                                <td><span class="badge-soft info">@scan.ScanType.GetDisplayName()</span></td>
                                <td>@((scan.FileSize / 1024.0).ToString("F1")) KB</td>
                                <td class="text-end">
                                    <a asp-controller="Scans" asp-action="View" asp-route-id="@scan.Id" class="btn btn-sm btn-outline-primary">İncele</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="section-title">Faturalar</h3>
        <a asp-controller="Billing" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Yeni Fatura</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Invoices.Any())
        {
            <p class="empty-state mb-0">Fatura kaydı bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            @if (canViewFinancials)
                            {
                                <th>Toplam</th>
                                <th>Ödenen</th>
                                <th>Kalan</th>
                            }
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td>@inv.InvoiceDate.ToString("d")</td>
                                @if (canViewFinancials)
                                {
                                    <td>@inv.TotalAmount.ToString("C")</td>
                                    <td>@inv.TotalPaid.ToString("C")</td>
                                    <td>@inv.Balance.ToString("C")</td>
                                }
                                <td><span class="badge-soft @(inv.Status == InvoiceStatus.Paid ? "success" : inv.Status == InvoiceStatus.Cancelled ? "neutral" : inv.Status == InvoiceStatus.PartiallyPaid ? "warning" : "info")">@inv.Status.GetDisplayName()</span></td>
                                <td class="text-end">
                                    <a asp-controller="Billing" asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
