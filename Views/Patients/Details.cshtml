@model DentistDB.Models.Patient
@{
    ViewData["Title"] = Model.FullName;
    var canViewFinancials = Context.CanViewFinancials();
}

<div class="page-header">
    <div>
        <div class="eyebrow">Hasta Dosyası</div>
        <h2 class="page-title">@Model.FullName</h2>
        <p class="page-subtitle">
            Kayıt tarihi @Model.CreatedAt.ToString("MMMM yyyy")
            <span class="badge-soft @(Model.IsArchived ? "neutral" : "success") ms-2">@(Model.IsArchived ? "Arşivde" : "Aktif")</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
        <a asp-controller="PreviousOperations" asp-action="Index" asp-route-patientId="@Model.Id" class="btn btn-outline-secondary">Önceki İşlemler</a>
        @if (!Model.IsArchived)
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu hastayı arşive taşımak istiyor musunuz?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Arşivle</button>
            </form>
        }
        else
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Geri Yükle</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MedicalAlerts))
{
    <div class="alert alert-danger">
        <strong>Tıbbi Uyarılar:</strong> @Model.MedicalAlerts
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Kimlik ve Fotoğraf</h3></div>
            <div class="card-body text-center">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoBase64) && !string.IsNullOrWhiteSpace(Model.PhotoContentType))
                {
                    <img src="data:@Model.PhotoContentType;base64,@Model.PhotoBase64" alt="@Model.FullName" class="patient-photo-preview__img patient-photo-preview__img--large mb-3" />
                }
                else
                {
                    <div class="patient-photo-placeholder mb-3">Fotoğraf yok</div>
                }
                <div class="small text-muted">Hasta</div>
                <div class="fs-5 fw-semibold">@Model.FullName</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">İletişim Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                    <dt class="col-sm-4">TCKN</dt>
                    <dd class="col-sm-8">@Model.Tckn</dd>
                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Doğum Tarihi</dt>
                    <dd class="col-sm-8">@(Model.BirthDate?.ToString("D") ?? "-")</dd>
                    <dt class="col-sm-4">Adres</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Klinik Notlar</h3></div>
            <div class="card-body">
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Bu hasta için not eklenmemiş." : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header pb-0">
        <ul class="nav nav-tabs card-header-tabs" id="patientDetailsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="appointments-tab" data-bs-toggle="tab" data-bs-target="#appointments-pane" type="button" role="tab" aria-controls="appointments-pane" aria-selected="true">Randevular</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="scans-tab" data-bs-toggle="tab" data-bs-target="#scans-pane" type="button" role="tab" aria-controls="scans-pane" aria-selected="false">Tıbbi Görüntüler</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="billing-tab" data-bs-toggle="tab" data-bs-target="#billing-pane" type="button" role="tab" aria-controls="billing-pane" aria-selected="false">Finans</button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="patientDetailsTabContent">
            <div class="tab-pane fade show active" id="appointments-pane" role="tabpanel" aria-labelledby="appointments-tab" tabindex="0">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <h3 class="section-title mb-0">Randevular</h3>
                    <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Yeni Randevu</a>
                </div>
                @if (!Model.Appointments.Any())
                {
                    <p class="empty-state mb-0">Bu hastaya ait randevu bulunmuyor.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Konu</th>
                                    <th>Durum</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.Appointments)
                                {
                                    var selectedTeeth = TeethSelectionSerializer.Parse(appt.SelectedTeethData);
                                    <tr>
                                        <td>@appt.AppointmentDate.ToString("f")</td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(appt.Purpose) ? "Belirtilmedi" : appt.Purpose)
                                            @if (appt.InvoiceId.HasValue)
                                            {
                                                <div class="mt-2">
                                                    <a asp-controller="Billing" asp-action="Details" asp-route-id="@appt.InvoiceId" class="badge-soft warning text-decoration-none">Finans Hesabı</a>
                                                </div>
                                            }
                                            @if (selectedTeeth.Any())
                                            {
                                                <div class="operation-teeth mt-2">
                                                    @foreach (var tooth in selectedTeeth)
                                                    {
                                                        <span class="badge-soft info">@tooth</span>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(appt.Notes))
                                            {
                                                <div class="text-muted small mt-1">@appt.Notes</div>
                                            }
                                        </td>
                                        <td><span class="badge-soft @(appt.Status == AppointmentStatus.Completed ? "success" : appt.Status == AppointmentStatus.Cancelled ? "neutral" : appt.Status == AppointmentStatus.NoShow ? "warning" : "info")">@appt.Status.GetDisplayName()</span></td>
                                        <td class="text-end">
                                            <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appt.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="scans-pane" role="tabpanel" aria-labelledby="scans-tab" tabindex="0">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <div>
                        <h3 class="section-title mb-1">Tıbbi Görüntüler ve Taramalar</h3>
                        <div class="small text-muted">JPG, PNG, PDF ve DICOM dosyaları hasta dosyasında saklanır.</div>
                    </div>
                    <a asp-controller="Scans" asp-action="Upload" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Tarama Yükle</a>
                </div>
                @if (!Model.Scans.Any())
                {
                    <p class="empty-state mb-0">Yüklenmiş tıbbi görüntü bulunmuyor.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Dosya</th>
                                    <th>Tür</th>
                                    <th>Format</th>
                                    <th>Boyut</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var scan in Model.Scans)
                                {
                                    var extension = System.IO.Path.GetExtension(scan.FileName).TrimStart('.').ToUpperInvariant();
                                    <tr>
                                        <td>@scan.ScanDate.ToString("d")</td>
                                        <td>@scan.FileName</td>
                                        <td><span class="badge-soft info">@scan.ScanType.GetDisplayName()</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(extension) ? "-" : extension)</td>
                                        <td>@((scan.FileSize / 1024.0).ToString("F1")) KB</td>
                                        <td class="text-end">
                                            <a asp-controller="Scans" asp-action="View" asp-route-id="@scan.Id" class="btn btn-sm btn-outline-primary">İncele</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="billing-pane" role="tabpanel" aria-labelledby="billing-tab" tabindex="0">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <h3 class="section-title mb-0">Finans Hesabı</h3>
                    <a asp-controller="Billing" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Finansı Aç</a>
                </div>
                @if (Model.Invoice == null)
                {
                    <p class="empty-state mb-0">Bu hasta için finans hesabı bulunmuyor.</p>
                }
                else
                {
                    <div class="p-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                                <div class="small text-muted">Hesap Tarihi</div>
                                <div class="fw-semibold">@Model.Invoice.InvoiceDate.ToString("d")</div>
                            </div>
                            @if (canViewFinancials)
                            {
                                <div class="col-md-2">
                                    <div class="small text-muted">Toplam</div>
                                    <div class="fw-semibold">@Model.Invoice.TotalAmount.ToString("C")</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="small text-muted">Ödenen</div>
                                    <div class="fw-semibold text-success">@Model.Invoice.TotalPaid.ToString("C")</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="small text-muted">Kalan</div>
                                    <div class="fw-semibold @(Model.Invoice.Balance > 0 ? "text-danger" : "text-success")">@Model.Invoice.Balance.ToString("C")</div>
                                </div>
                                <div class="col-md-1">
                                    <div class="small text-muted">Taksit</div>
                                    <div class="fw-semibold">@Model.Invoice.Installments.Count(p => !p.IsSettled)</div>
                                </div>
                            }
                            <div class="col-md-2 text-md-end">
                                <span class="badge-soft @(Model.Invoice.Status == InvoiceStatus.Paid ? "success" : Model.Invoice.Status == InvoiceStatus.Cancelled ? "neutral" : Model.Invoice.Status == InvoiceStatus.PartiallyPaid ? "warning" : "info")">@Model.Invoice.Status.GetDisplayName()</span>
                                <div class="mt-2">
                                    <a asp-controller="Billing" asp-action="Details" asp-route-id="@Model.Invoice.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
