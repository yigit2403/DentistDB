@model DentistDB.Models.Patient
@{
    ViewData["Title"] = Model.FullName;
    var canViewFinancials = Context.CanViewFinancials();
}

<div class="page-header">
    <div>
        <div class="eyebrow">Hasta Dosyasi</div>
        <h2 class="page-title">@Model.FullName</h2>
        <p class="page-subtitle">
            Gelis tarihi @(Model.ArrivalDate?.ToString("D") ?? "belirtilmemis")
            <span class="badge-soft @(Model.IsArchived ? "neutral" : "success") ms-2">@(Model.IsArchived ? "Arsivde" : "Aktif")</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Duzenle</a>
        <a asp-controller="PreviousOperations" asp-action="Index" asp-route-patientId="@Model.Id" class="btn btn-outline-secondary">Onceki Islemler</a>
        @if (!Model.IsArchived)
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu hastayi arsive tasimak istiyor musunuz?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Arsivle</button>
            </form>
        }
        else
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Geri Yukle</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MedicalAlerts))
{
    <div class="alert alert-danger">
        <strong>Tibbi Uyarilar:</strong> @Model.MedicalAlerts
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Kimlik ve Fotograf</h3></div>
            <div class="card-body text-center">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoBase64) && !string.IsNullOrWhiteSpace(Model.PhotoContentType))
                {
                    <img src="data:@Model.PhotoContentType;base64,@Model.PhotoBase64" alt="@Model.FullName" class="patient-photo-preview__img patient-photo-preview__img--large mb-3" />
                }
                else
                {
                    <div class="patient-photo-placeholder mb-3">Fotograf yok</div>
                }
                <div class="small text-muted">TCKN</div>
                <div class="fs-5 fw-semibold">@Model.Tckn</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Iletisim Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
                    <dt class="col-sm-4">TCKN</dt>
                    <dd class="col-sm-8">@Model.Tckn</dd>
                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Dogum Tarihi</dt>
                    <dd class="col-sm-8">@(Model.BirthDate?.ToString("D") ?? "-")</dd>
                    <dt class="col-sm-4">Gelis Tarihi</dt>
                    <dd class="col-sm-8">@(Model.ArrivalDate?.ToString("D") ?? "-")</dd>
                    <dt class="col-sm-4">Adres</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Klinik Notlar</h3></div>
            <div class="card-body">
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Bu hasta icin not eklenmemis." : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="section-title">Randevular</h3>
        <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Yeni Randevu</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Appointments.Any())
        {
            <p class="empty-state mb-0">Bu hastaya ait randevu bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Konu</th>
                            <th>Durum</th>
                            <th class="text-end">Islem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            var selectedTeeth = TeethSelectionSerializer.Parse(appt.SelectedTeethData);
                            <tr>
                                <td>@appt.AppointmentDate.ToString("f")</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(appt.Purpose) ? "Belirtilmedi" : appt.Purpose)
                                    @if (selectedTeeth.Any())
                                    {
                                        <div class="operation-teeth mt-2">
                                            @foreach (var tooth in selectedTeeth)
                                            {
                                                <span class="badge-soft info">@tooth</span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(appt.Notes))
                                    {
                                        <div class="text-muted small mt-1">@appt.Notes</div>
                                    }
                                </td>
                                <td><span class="badge-soft @(appt.Status == AppointmentStatus.Completed ? "success" : appt.Status == AppointmentStatus.Cancelled ? "neutral" : appt.Status == AppointmentStatus.NoShow ? "warning" : "info")">@appt.Status.GetDisplayName()</span></td>
                                <td class="text-end">
                                    <a asp-controller="Appointments" asp-action="Edit" asp-route-id="@appt.Id" class="btn btn-sm btn-outline-secondary">Duzenle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="section-title">Goruntuler ve Taramalar</h3>
        <a asp-controller="Scans" asp-action="Upload" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Tarama Yukle</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Scans.Any())
        {
            <p class="empty-state mb-0">Yuklenmis tarama bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Dosya</th>
                            <th>Tur</th>
                            <th>Boyut</th>
                            <th class="text-end">Islem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scan in Model.Scans)
                        {
                            <tr>
                                <td>@scan.ScanDate.ToString("d")</td>
                                <td>@scan.FileName</td>
                                <td><span class="badge-soft info">@scan.ScanType.GetDisplayName()</span></td>
                                <td>@((scan.FileSize / 1024.0).ToString("F1")) KB</td>
                                <td class="text-end">
                                    <a asp-controller="Scans" asp-action="View" asp-route-id="@scan.Id" class="btn btn-sm btn-outline-primary">Incele</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="section-title">Faturalar</h3>
        <a asp-controller="Billing" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-outline-primary">Yeni Fatura</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Invoices.Any())
        {
            <p class="empty-state mb-0">Fatura kaydi bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            @if (canViewFinancials)
                            {
                                <th>Toplam</th>
                                <th>Odenen</th>
                                <th>Kalan</th>
                                <th>Plan</th>
                            }
                            <th>Durum</th>
                            <th class="text-end">Islem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td>@inv.InvoiceDate.ToString("d")</td>
                                @if (canViewFinancials)
                                {
                                    <td>@inv.TotalAmount.ToString("C")</td>
                                    <td>@inv.TotalPaid.ToString("C")</td>
                                    <td>@inv.Balance.ToString("C")</td>
                                    <td>@inv.PlannedPayments.Count(p => !p.IsSettled)</td>
                                }
                                <td><span class="badge-soft @(inv.Status == InvoiceStatus.Paid ? "success" : inv.Status == InvoiceStatus.Cancelled ? "neutral" : inv.Status == InvoiceStatus.PartiallyPaid ? "warning" : "info")">@inv.Status.GetDisplayName()</span></td>
                                <td class="text-end">
                                    <a asp-controller="Billing" asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
