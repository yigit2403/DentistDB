@model DentistDB.ViewModels.PatientIndexViewModel
@{
    ViewData["Title"] = "Hastalar";
    var list = Model.Patients;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Hastalar</h2>
        <p class="page-subtitle">@list.TotalCount kayıt@(Model.ShowArchived ? " (arşiv dahil)" : "")</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><svg class="icon"><use href="#i-user-plus"/></svg> Yeni Hasta</a>
    </div>
</div>

<div class="card">
    <div class="card-body py-3">
        <form method="get" class="filter-bar">
            <div class="quick-search" style="width:min(420px,100%)">
                <svg class="icon"><use href="#i-search"/></svg>
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Ad, TCKN, telefon veya e-posta…" aria-label="Hasta ara" autocomplete="off" data-autofocus />
            </div>
            <div class="form-check m-0">
                <input type="checkbox" name="showArchived" value="true" class="form-check-input" id="chkArchived" @(Model.ShowArchived ? "checked" : "") data-autosubmit />
                <label class="form-check-label" for="chkArchived">Arşivdekileri göster</label>
            </div>
            <button type="submit" class="btn btn-outline-primary">Ara</button>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.ShowArchived)
            {
                <a asp-action="Index" class="btn btn-ghost">Temizle</a>
            }
        </form>
    </div>
</div>

<div class="card">
    @if (!list.Any())
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-users"/></svg>
            <p>@(string.IsNullOrEmpty(Model.Search) ? "Henüz hasta kaydı yok." : $"“{Model.Search}” için sonuç bulunamadı.")</p>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a asp-action="Create" class="btn btn-sm btn-primary">Yeni Hasta Oluştur</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Hasta</th>
                        <th>TCKN</th>
                        <th>Telefon</th>
                        <th>Yaş</th>
                        <th>Son Ziyaret</th>
                        <th>Sonraki Randevu</th>
                        <th>Durum</th>
                        <th class="row-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in list)
                    {
                        int? age = null;
                        if (p.BirthDate is { } bd)
                        {
                            var today = DateOnly.FromDateTime(DateTime.Today);
                            age = today.Year - bd.Year - (bd > today.AddYears(-(today.Year - bd.Year)) ? 1 : 0);
                        }
                        <tr data-href="@Url.Action("Details", new { id = p.Id })">
                            <td>
                                <div class="person">
                                    <partial name="_Avatar" model="new AvatarModel(p.Id, p.FullName, p.HasPhoto)" />
                                    <div class="min-w-0">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="person-name">@p.FullName</a>
                                        @if (p.HasMedicalAlerts)
                                        {
                                            <span class="badge-soft danger ms-1">Tıbbi Uyarı</span>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="person-sub truncate">@p.Email</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="num">@p.Tckn</td>
                            <td class="num">@(p.Phone.FormatPhone() ?? "—")</td>
                            <td class="num">@(age?.ToString() ?? "—")</td>
                            <td>@(p.LastVisit?.ToShortDate() ?? "—")</td>
                            <td>
                                @if (p.NextAppointment is { } next)
                                {
                                    <span class="@(next.Date == DateTime.Today ? "fw-600 text-primary" : "")">@next.ToDateTimeText()</span>
                                }
                                else
                                {
                                    <span class="text-faint">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge-soft @(p.IsArchived ? "neutral" : "success")">@(p.IsArchived ? "Arşivde" : "Aktif")</span>
                            </td>
                            <td class="row-actions">
                                <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@p.Id" class="btn btn-sm btn-outline-secondary" title="Randevu ver" aria-label="Randevu ver"><svg class="icon" aria-hidden="true"><use href="#i-calendar-plus"/></svg></a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="Düzenle"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="new PaginationViewModel
        {
            PageIndex = list.PageIndex,
            TotalPages = list.TotalPages,
            TotalCount = list.TotalCount,
            PageSize = list.PageSize,
            FirstItemNumber = list.FirstItemNumber,
            LastItemNumber = list.LastItemNumber
        }" />
    }
</div>
