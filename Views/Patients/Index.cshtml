@model IEnumerable<DentistDB.Models.Patient>
@{
    ViewData["Title"] = "Patients";
    var showArchived = (bool)(ViewBag.ShowArchived ?? false);
    var search = ViewBag.Search as string;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2>👤 Patients</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Patient</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <input type="text" name="search" value="@search" class="form-control"
                       placeholder="Search by name, phone, or email..." />
            </div>
            <div class="col-md-auto">
                <div class="form-check">
                    <input type="checkbox" name="showArchived" value="true" class="form-check-input"
                           id="chkArchived" @(showArchived ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label" for="chkArchived">Show Archived</label>
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="Index" class="btn btn-link">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No patients found.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Date of Birth</th>
                        <th>Alerts</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@patient.Id" class="text-decoration-none fw-semibold">
                                    @patient.FullName
                                </a>
                            </td>
                            <td>@patient.Phone</td>
                            <td>@patient.Email</td>
                            <td>@patient.BirthDate?.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(patient.MedicalAlerts))
                                {
                                    <span class="badge bg-danger" title="@patient.MedicalAlerts">⚠ Alerts</span>
                                }
                            </td>
                            <td>
                                @if (patient.IsArchived)
                                {
                                    <span class="badge bg-secondary">Archived</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
