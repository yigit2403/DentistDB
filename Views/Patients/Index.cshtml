@model IEnumerable<DentistDB.Models.Patient>
@{
    ViewData["Title"] = "Hastalar";
    var showArchived = (bool)(ViewBag.ShowArchived ?? false);
    var search = ViewBag.Search as string;
}

<div class="page-header">
    <div>
        <div class="eyebrow">Hasta Listesi</div>
        <h2 class="page-title">Tüm hasta kartlarını hızlıca yönetin.</h2>
        <p class="page-subtitle">Arama, arşiv filtreleme ve detaylara geçiş tek ekranda.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Hasta</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-7">
                <label class="form-label">Arama</label>
                <input type="text" name="search" value="@search" class="form-control" placeholder="Ad, telefon veya e-posta ile ara" />
            </div>
            <div class="col-lg-3">
                <div class="form-check pt-4">
                    <input type="checkbox" name="showArchived" value="true" class="form-check-input" id="chkArchived" @(showArchived ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label" for="chkArchived">Arşivlenenleri göster</label>
                </div>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Ara</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Aramanıza uygun hasta bulunamadı.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hasta</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th>Doğum Tarihi</th>
                        <th>Uyarılar</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@patient.Id" class="text-decoration-none fw-semibold">@patient.FullName</a>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(patient.Phone) ? "-" : patient.Phone)</td>
                            <td>@(string.IsNullOrWhiteSpace(patient.Email) ? "-" : patient.Email)</td>
                            <td>@(patient.BirthDate?.ToString("d") ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(patient.MedicalAlerts))
                                {
                                    <span class="badge-soft danger">Tıbbi Uyarı</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge-soft @(patient.IsArchived ? "neutral" : "success")">
                                    @(patient.IsArchived ? "Arşivde" : "Aktif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
