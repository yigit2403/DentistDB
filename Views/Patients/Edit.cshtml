@model DentistDB.ViewModels.PatientFormViewModel
@{
    ViewData["Title"] = "Hasta Düzenle";
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index">Hastalar</a> / <a asp-action="Details" asp-route-id="@Model.Id">@Model.FullName</a></div>
        <h2 class="page-title">Hasta Bilgilerini Düzenle</h2>
    </div>
</div>

<div class="card content--narrow">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <partial name="_PatientForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Değişiklikleri Kaydet</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
