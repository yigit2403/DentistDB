@model DentistDB.ViewModels.PatientFormViewModel
@{
    ViewData["Title"] = "Yeni Hasta";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Yeni Hasta Kartı</h2>
        <p class="page-subtitle">Zorunlu alanlar yıldızla işaretlidir.</p>
    </div>
</div>

<div class="card content--narrow">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <partial name="_PatientForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Hastayı Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
