@model DentistDB.ViewModels.TreatmentRecordFormViewModel
@{
    ViewData["Title"] = "Tedavi Kaydi Duzenle";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Klinik Kayit</div>
        <h2 class="page-title">Tedavi kaydini duzenleyin.</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PatientId" class="form-label"></label>
                    <select asp-for="PatientId" asp-items="Model.Patients" class="form-select">
                        <option value="">Hasta secin</option>
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" type="date" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Diagnosis" class="form-label"></label>
                    <input asp-for="Diagnosis" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Procedures" class="form-label"></label>
                    <input asp-for="Procedures" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Prescriptions" class="form-label"></label>
                    <input asp-for="Prescriptions" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Degisiklikleri Kaydet</button>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-secondary">Vazgec</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
