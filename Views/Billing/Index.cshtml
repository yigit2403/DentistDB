@model IEnumerable<DentistDB.Models.Invoice>
@{
    ViewData["Title"] = "Billing";
    var statusFilter = ViewBag.StatusFilter as string;
    var statuses = ViewBag.Statuses as string[];
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2>💳 Invoices</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Invoice</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(statusFilter) ? "btn-dark" : "btn-outline-secondary")">All</a>
            @foreach (var s in (statuses ?? Array.Empty<string>()))
            {
                <a asp-action="Index" asp-route-status="@s"
                   class="btn btn-sm @(statusFilter == s ? "btn-dark" : "btn-outline-secondary")">@s</a>
            }
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No invoices found.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Due</th>
                        <th>Total</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>@inv.Id</td>
                            <td>
                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@inv.PatientId"
                                   class="text-decoration-none">@inv.Patient?.FullName</a>
                            </td>
                            <td>@inv.InvoiceDate.ToString("MMM d, yyyy")</td>
                            <td class="@(inv.DueDate < DateOnly.FromDateTime(DateTime.Today) && inv.Status != InvoiceStatus.Paid ? "text-danger" : "")">
                                @inv.DueDate?.ToString("MMM d, yyyy")
                            </td>
                            <td>@inv.TotalAmount.ToString("C")</td>
                            <td class="@(inv.Balance > 0 ? "text-danger fw-bold" : "text-success")">
                                @inv.Balance.ToString("C")
                            </td>
                            <td>
                                <span class="badge @(inv.Status == InvoiceStatus.Paid ? "bg-success" :
                                                     inv.Status == InvoiceStatus.Cancelled ? "bg-secondary" :
                                                     inv.Status == InvoiceStatus.PartiallyPaid ? "bg-warning text-dark" :
                                                     inv.Status == InvoiceStatus.Draft ? "bg-light text-dark" : "bg-primary")">
                                    @inv.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
