@model IEnumerable<DentistDB.Models.Invoice>
@{
    ViewData["Title"] = "Faturalar";
    var statusFilter = ViewBag.StatusFilter as string;
    var statuses = ViewBag.Statuses as InvoiceStatus[] ?? Array.Empty<InvoiceStatus>();
    var canViewFinancials = Context.CanViewFinancials();
}

<div class="page-header">
    <div>
        <div class="eyebrow">Finans Takibi</div>
        <h2 class="page-title">Faturaları, vadeleri ve tahsilat durumlarını izleyin.</h2>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Fatura</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="filter-strip">
            <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(statusFilter) ? "btn-primary" : "btn-outline-secondary")">Tümü</a>
            @foreach (var status in statuses)
            {
                <a asp-action="Index" asp-route-status="@status" class="btn btn-sm @(statusFilter == status.ToString() ? "btn-primary" : "btn-outline-secondary")">@status.GetDisplayName()</a>
            }
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Fatura bulunamadı.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>No</th>
                        <th>Hasta</th>
                        <th>Fatura Tarihi</th>
                        <th>Vade</th>
                        @if (canViewFinancials)
                        {
                            <th>Toplam</th>
                            <th>Kalan</th>
                        }
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>#@inv.Id</td>
                            <td><a asp-controller="Patients" asp-action="Details" asp-route-id="@inv.PatientId" class="text-decoration-none">@inv.Patient?.FullName</a></td>
                            <td>@inv.InvoiceDate.ToString("d")</td>
                            <td class="@(inv.DueDate < DateOnly.FromDateTime(DateTime.Today) && inv.Status != InvoiceStatus.Paid ? "text-danger fw-semibold" : string.Empty)">
                                @(inv.DueDate?.ToString("d") ?? "-")
                            </td>
                            @if (canViewFinancials)
                            {
                                <td>@inv.TotalAmount.ToString("C")</td>
                                <td class="@(inv.Balance > 0 ? "text-danger fw-semibold" : "text-success fw-semibold")">@inv.Balance.ToString("C")</td>
                            }
                            <td><span class="badge-soft @(inv.Status == InvoiceStatus.Paid ? "success" : inv.Status == InvoiceStatus.Cancelled ? "neutral" : inv.Status == InvoiceStatus.PartiallyPaid ? "warning" : "info")">@inv.Status.GetDisplayName()</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
