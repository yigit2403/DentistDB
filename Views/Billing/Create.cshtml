@model DentistDB.ViewModels.InvoiceFormViewModel
@{
    ViewData["Title"] = "Yeni Fatura";
    var proceduresJson = System.Text.Json.JsonSerializer.Serialize(Model.Procedures.Select(p => new { id = p.Id, name = p.Name, price = p.DefaultPrice }));
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index">Faturalar</a> / Yeni</div>
        <h2 class="page-title">Yeni Fatura@(Model.PatientName != null ? $" · {Model.PatientName}" : "")</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" data-invoice-form data-procedures="@proceduresJson" data-unsaved-guard>
            @Html.AntiForgeryToken()
            <partial name="_InvoiceForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Faturayı Oluştur</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/invoice-form.js" asp-append-version="true"></script>
}
