@model DentistDB.ViewModels.PaymentFormViewModel
@{
    ViewData["Title"] = "Odeme Ekle";
    var invoice = ViewBag.Invoice as DentistDB.Models.Invoice;
}

<div class="page-header">
    <div>
        <div class="eyebrow">Tahsilat</div>
        <h2 class="page-title">Fatura icin odeme kaydi ekleyin.</h2>
        @if (invoice != null)
        {
            <p class="page-subtitle">Fatura #@invoice.Id - @invoice.Patient?.FullName - Kalan bakiye: <strong class="text-danger">@invoice.Balance.ToString("C")</strong></p>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="AddPayment" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="InvoiceId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                @if (Model.PlannedPayments.Any())
                {
                    <div class="col-md-12">
                        <label asp-for="PlannedPaymentId" class="form-label"></label>
                        <select asp-for="PlannedPaymentId" asp-items="Model.PlannedPayments" class="form-select">
                            <option value="">Plan disi manuel odeme</option>
                        </select>
                        <span asp-validation-for="PlannedPaymentId" class="text-danger small"></span>
                    </div>
                }
                <div class="col-md-3">
                    <label asp-for="PaymentDate" class="form-label"></label>
                    <input asp-for="PaymentDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">TL</span>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
                </div>
                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success">Odemeyi Kaydet</button>
                <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">Vazgec</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
