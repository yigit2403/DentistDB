@model DentistDB.Models.Invoice
@{
    ViewData["Title"] = $"Finans Hesabı #{Model.Id}";
    var canViewFinancials = Context.CanViewFinancials();
}

<div class="page-header">
    <div>
        <div class="eyebrow">Finans Hesabı Detayı</div>
        <h2 class="page-title">@Model.Patient?.FullName</h2>
        <p class="page-subtitle">
            Hesap #@Model.Id
            <span class="badge-soft @(Model.Status == InvoiceStatus.Paid ? "success" : Model.Status == InvoiceStatus.Cancelled ? "neutral" : Model.Status == InvoiceStatus.PartiallyPaid ? "warning" : "info") ms-2">@Model.Status.GetDisplayName()</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (canViewFinancials)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
            @if (Model.Status != InvoiceStatus.Paid && Model.Status != InvoiceStatus.Cancelled)
            {
                <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" class="btn btn-success">Ödeme Ekle</a>
            }
        }
    </div>
</div>

@if (canViewFinancials)
{
    <section class="summary-grid mb-4">
        <article class="stats-card glass-card text-center">
            <div class="label">Toplam Tutar</div>
            <div class="value">@Model.TotalAmount.ToString("C")</div>
        </article>
        <article class="stats-card glass-card text-center">
            <div class="label">Ödenen</div>
            <div class="value text-success">@Model.TotalPaid.ToString("C")</div>
        </article>
        <article class="stats-card glass-card text-center">
            <div class="label">Kalan Bakiye</div>
            <div class="value @(Model.Balance > 0 ? "text-danger" : "text-success")">@Model.Balance.ToString("C")</div>
        </article>
    </section>
}
else
{
    <div class="alert alert-info mb-4">Çalışan hesabı tutarları, ödemeleri ve bakiyeleri göremez.</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h3 class="section-title">Hesap Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Hesap Tarihi</dt>
                    <dd class="col-sm-7">@Model.InvoiceDate.ToString("D")</dd>
                    <dt class="col-sm-5">Son Ödeme Tarihi</dt>
                    <dd class="col-sm-7">@(Model.DueDate?.ToString("D") ?? "-")</dd>
                    <dt class="col-sm-5">Notlar</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
                </dl>
            </div>
        </div>
    </div>

    @if (canViewFinancials)
    {
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h3 class="section-title">Ödeme Geçmişi</h3></div>
                <div class="card-body p-0">
                    @if (!Model.Payments.Any(p => !p.IsPlanned || p.IsSettled))
                    {
                        <p class="empty-state mb-0">Bu hesap için kayıtlı ödeme yok.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var pay in Model.Payments.Where(p => !p.IsPlanned || p.IsSettled).OrderByDescending(p => p.SettledDate ?? p.PaymentDate))
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between gap-3">
                                        <div>
                                            <div class="fw-semibold">@pay.Amount.ToString("C")</div>
                                            <div class="text-muted small">@((pay.SettledDate ?? pay.PaymentDate).ToString("D"))</div>
                                            @if (!string.IsNullOrWhiteSpace(pay.Notes))
                                            {
                                                <div class="text-muted small">@pay.Notes</div>
                                            }
                                        </div>
                                        <span class="badge-soft info">@pay.PaymentMethod.GetDisplayName()</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header"><h3 class="section-title">Taksitler</h3></div>
                <div class="card-body p-0">
                    @if (!Model.Installments.Any())
                    {
                        <p class="empty-state mb-0">Bu hesap için tanımlı taksit yok.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Taksit</th>
                                        <th>Planlanan Tarih</th>
                                        <th>Tutar</th>
                                        <th>Durum</th>
                                        <th>Tahsil Tarihi</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Installments)
                                    {
                                        <tr>
                                            <td>@(item.InstallmentNumber ?? 0)</td>
                                            <td>@item.PaymentDate.ToString("D")</td>
                                            <td>@item.Amount.ToString("C")</td>
                                            <td><span class="badge-soft @(item.IsSettled ? "success" : "warning")">@(item.IsSettled ? "Tahsil edildi" : "Bekliyor")</span></td>
                                            <td>@(item.SettledDate?.ToString("D") ?? "-")</td>
                                            <td class="text-end">
                                                @if (!item.IsSettled && Model.Status != InvoiceStatus.Paid && Model.Status != InvoiceStatus.Cancelled)
                                                {
                                                    <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" asp-route-installmentId="@item.Id" class="btn btn-sm btn-outline-success">Tahsil Et</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
