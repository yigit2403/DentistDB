@model DentistDB.Models.Invoice
@{
    ViewData["Title"] = $"Invoice #{Model.Id}";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2>Invoice #@Model.Id</h2>
        <p class="text-muted mb-0">
            <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
               class="text-decoration-none">@Model.Patient?.FullName</a>
            &mdash;
            <span class="badge @(Model.Status == InvoiceStatus.Paid ? "bg-success" :
                                  Model.Status == InvoiceStatus.Cancelled ? "bg-secondary" :
                                  Model.Status == InvoiceStatus.PartiallyPaid ? "bg-warning text-dark" : "bg-primary")">
                @Model.Status
            </span>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        @if (Model.Status != InvoiceStatus.Paid && Model.Status != InvoiceStatus.Cancelled)
        {
            <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" class="btn btn-success">+ Record Payment</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted small">Total Amount</div>
                <div class="fs-3 fw-bold">@Model.TotalAmount.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted small">Total Paid</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalPaid.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted small">Outstanding Balance</div>
                <div class="fs-3 fw-bold @(Model.Balance > 0 ? "text-danger" : "text-success")">
                    @Model.Balance.ToString("C")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><strong>Invoice Details</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Invoice Date</dt>
                    <dd class="col-sm-7">@Model.InvoiceDate.ToString("MMMM d, yyyy")</dd>
                    <dt class="col-sm-5">Due Date</dt>
                    <dd class="col-sm-7">@(Model.DueDate?.ToString("MMMM d, yyyy") ?? "—")</dd>
                    <dt class="col-sm-5">Notes</dt>
                    <dd class="col-sm-7">@(Model.Notes ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Payment History</strong>
            </div>
            <div class="card-body p-0">
                @if (!Model.Payments.Any())
                {
                    <p class="text-muted p-3 mb-0">No payments recorded.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var pay in Model.Payments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@pay.Amount.ToString("C")</div>
                                    <div class="text-muted small">@pay.PaymentDate.ToString("MMM d, yyyy") &mdash; @pay.PaymentMethod</div>
                                    @if (!string.IsNullOrEmpty(pay.Notes))
                                    {
                                        <div class="text-muted small">@pay.Notes</div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
