@model DentistDB.Models.Invoice
@{
    ViewData["Title"] = $"Fatura #{Model.Id}";
    var isAdmin = Context.IsAdmin();
    var showFinancials = Context.CanViewFinancials();
    var isOpen = Model.Status is InvoiceStatus.Issued or InvoiceStatus.PartiallyPaid;
    var items = Model.Items.OrderBy(i => i.SortOrder).ToList();
    var planned = Model.PlannedPayments.ToList();
    var settled = Model.SettledPayments.ToList();
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index">Faturalar</a> / #@Model.Id</div>
        <h2 class="page-title d-flex align-items-center gap-2 flex-wrap">
            Fatura #@Model.Id
            <span class="badge-soft @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span>
            @if (Model.IsOverdue) { <span class="badge-soft danger">Vadesi geçti</span> }
        </h2>
        <p class="page-subtitle">
            <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="invoices">@Model.Patient?.FullName</a>
            · @Model.InvoiceDate.ToShortDate()
            @if (Model.DueDate.HasValue) { <text>· vade @Model.DueDate.ToShortDate()</text> }
        </p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><svg class="icon"><use href="#i-print"/></svg> Yazdır</button>
        @if (isAdmin)
        {
            @if (isOpen)
            {
                <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" class="btn btn-success"><svg class="icon"><use href="#i-coins"/></svg> Tahsilat Ekle</a>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><svg class="icon"><use href="#i-edit"/></svg> Düzenle</a>
            @if (Model.Status == InvoiceStatus.Cancelled)
            {
                <form asp-action="Reopen" asp-route-id="@Model.Id" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary"><svg class="icon"><use href="#i-refresh"/></svg> Yeniden Aç</button>
                </form>
            }
            else if (Model.TotalPaid == 0)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="m-0" data-confirm="Fatura iptal edilsin mi? İptal edilen fatura alacak toplamına dahil edilmez.">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger"><svg class="icon"><use href="#i-x"/></svg> İptal Et</button>
                </form>
            }
        }
    </div>
</div>

@if (showFinancials)
{
    <div class="invoice-summary mb-3">
        <div class="stat">
            <span class="stat-label">Toplam</span>
            <span class="stat-value money">@Model.TotalAmount.ToMoney()</span>
            <span class="stat-hint">@items.Count kalem</span>
        </div>
        <div class="stat stat-success">
            <span class="stat-label">Tahsil Edilen</span>
            <span class="stat-value money">@Model.TotalPaid.ToMoney()</span>
            <span class="stat-hint">@settled.Count ödeme</span>
        </div>
        <div class="stat @(Model.Balance > 0 && isOpen ? "stat-danger" : "")">
            <span class="stat-label">Kalan</span>
            <span class="stat-value money">@Model.Balance.ToMoney()</span>
            <span class="stat-hint">@(planned.Count > 0 ? $"{planned.Count(p => !p.IsSettled)} taksit bekliyor" : "taksit planı yok")</span>
        </div>
    </div>
}
else
{
    <div class="alert alert-info mb-3"><svg class="icon"><use href="#i-info"/></svg><div>Tutarlar ve ödemeler yalnızca yönetici hesabında görüntülenir.</div></div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Fatura Kalemleri</h3></div>
            @if (!items.Any())
            {
                <div class="empty-state"><p>Bu faturada kalem yok.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table invoice-lines">
                        <thead>
                            <tr>
                                <th style="width:32px">#</th>
                                <th>İşlem</th>
                                <th>Diş</th>
                                @if (showFinancials) { <th class="text-end">Adet</th><th class="text-end">Birim</th><th class="text-end">Tutar</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < items.Count; i++)
                            {
                                var item = items[i];
                                <tr>
                                    <td class="num text-muted">@(i + 1)</td>
                                    <td>@item.Description</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ToothNumbers))
                                        {
                                            <span class="tooth-chips">@foreach (var t in item.ToothNumbers.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <span class="tooth-chip">@t</span> }</span>
                                        }
                                        else { <span class="text-faint">—</span> }
                                    </td>
                                    @if (showFinancials)
                                    {
                                        <td class="text-end num">@item.Quantity</td>
                                        <td class="text-end money">@item.UnitPrice.ToMoney()</td>
                                        <td class="text-end money fw-600">@item.LineTotal.ToMoney()</td>
                                    }
                                </tr>
                            }
                        </tbody>
                        @if (showFinancials)
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end fw-600">Genel Toplam</td>
                                    <td class="text-end money fw-600" style="font-size:1rem">@Model.TotalAmount.ToMoney()</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card">
                <div class="card-header"><h3 class="card-title">Notlar</h3></div>
                <div class="card-body pre-wrap">@Model.Notes</div>
            </div>
        }
    </div>

    @if (showFinancials)
    {
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Ödemeler</h3>
                    @if (isAdmin && isOpen)
                    {
                        <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" class="btn btn-sm btn-outline-primary"><svg class="icon"><use href="#i-plus"/></svg> Tahsilat</a>
                    }
                </div>
                @if (!settled.Any())
                {
                    <div class="empty-state"><p>Henüz ödeme alınmadı.</p></div>
                }
                else
                {
                    <ul class="list">
                        @foreach (var pay in settled)
                        {
                            <li class="list-item">
                                <div class="grow">
                                    <div class="title money">@pay.Amount.ToMoney()</div>
                                    <div class="meta">
                                        @((pay.SettledDate ?? pay.PaymentDate).ToShortDate()) · @pay.PaymentMethod.GetDisplayName()
                                        @if (pay.IsPlanned) { <text>· @pay.InstallmentNumber. taksit</text> }
                                        @if (!string.IsNullOrWhiteSpace(pay.Notes)) { <text>· @pay.Notes</text> }
                                    </div>
                                </div>
                                @if (isAdmin)
                                {
                                    <form asp-action="DeletePayment" asp-route-id="@pay.Id" method="post" class="m-0" data-confirm="@(pay.IsPlanned ? "Bu taksitin tahsilatı geri alınsın mı?" : "Bu ödeme kaydı silinsin mi?")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-ghost btn-icon text-danger" title="@(pay.IsPlanned ? "Tahsilatı geri al" : "Sil")"><svg class="icon"><use href="#i-trash"/></svg></button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="card">
                <div class="card-header"><h3 class="card-title">Taksit Planı</h3></div>
                @if (!planned.Any())
                {
                    <div class="empty-state"><p>Bu fatura için taksit planı yok.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>#</th><th>Vade</th><th class="text-end">Tutar</th><th>Durum</th><th class="row-actions"></th></tr></thead>
                            <tbody>
                                @foreach (var p in planned)
                                {
                                    <tr>
                                        <td class="num">@p.InstallmentNumber</td>
                                        <td class="@(p.IsOverdue ? "text-danger fw-600" : "")">@p.PaymentDate.ToShortDate()</td>
                                        <td class="text-end money">@p.Amount.ToMoney()</td>
                                        <td>
                                            @if (p.IsSettled)
                                            {
                                                <span class="badge-soft success">Ödendi @p.SettledDate.ToShortDate()</span>
                                            }
                                            else if (p.IsOverdue)
                                            {
                                                <span class="badge-soft danger">Gecikti</span>
                                            }
                                            else
                                            {
                                                <span class="badge-soft warning">Bekliyor</span>
                                            }
                                        </td>
                                        <td class="row-actions">
                                            @if (isAdmin && !p.IsSettled && isOpen)
                                            {
                                                <a asp-action="AddPayment" asp-route-invoiceId="@Model.Id" asp-route-plannedPaymentId="@p.Id" class="btn btn-sm btn-outline-primary">Tahsil Et</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (isAdmin && Model.TotalPaid == 0)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3 no-print" data-confirm="Fatura #@Model.Id kalıcı olarak silinsin mi? Bu işlem geri alınamaz.">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger"><svg class="icon"><use href="#i-trash"/></svg> Faturayı Sil</button>
                </form>
            }
        </div>
    }
</div>
