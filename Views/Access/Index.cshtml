@model DentistDB.ViewModels.AccessSelectionViewModel
@{
    ViewData["Title"] = "Hesap Seçimi";
}

<section class="hero-panel glass-card access-hero">
    <div class="page-header mb-0">
        <div>
            <div class="eyebrow">Hızlı Giriş</div>
            <h2 class="page-title">Çalışacağınız hesabı seçin.</h2>
        </div>
    </div>
</section>

<div class="account-grid">
    @foreach (var account in Model.Accounts)
    {
        var isAdmin = account.Role == AppAccountRole.Admin;
        <div class="account-card glass-card">
            <div class="eyebrow">@(isAdmin ? "Yönetici" : "Çalışan")</div>
            <h3 class="section-title mt-2">@account.Name</h3>

            <form asp-action="Select" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="AccountKey" value="@account.Key" />

                <div class="mb-3">
                    <label asp-for="Pin" class="form-label">@(isAdmin ? "Yönetici PIN'i" : "Çalışan PIN'i")</label>
                    <input asp-for="Pin" class="form-control" inputmode="numeric" autocomplete="current-password" placeholder="PIN girin" />
                    <span asp-validation-for="Pin" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn @(isAdmin ? "btn-primary" : "btn-outline-primary") w-100">Bu Hesapla Devam Et</button>
            </form>
        </div>
    }
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
