@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="card">
    <div class="card-body p-4">
        <div class="eyebrow">Sistem Bildirimi</div>
        <h2 class="page-title text-danger">Bir hata olustu.</h2>
        <p class="page-subtitle">Istek islenirken beklenmeyen bir sorun meydana geldi.</p>

        @if (Model.ShowRequestId)
        {
            <p><strong>Istek Numarasi:</strong> <code>@Model.RequestId</code></p>
        }

        <h3 class="section-title mt-4">Geliştirme Modu</h3>
        <p class="mb-2">Geliştirme ortamına geçildiğinde hataya dair daha ayrıntılı teknik bilgi görüntülenir.</p>
        <p class="mb-0"><strong>Canli ortamlarda gelistirme modu acik olmamalidir.</strong> Son kullanicilara hassas hata bilgileri gosterilebilir.</p>
    </div>
</div>
