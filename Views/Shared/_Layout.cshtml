@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentAccount = Context.GetCurrentAccount();
    var isSignedIn = currentAccount != null;
    var canViewFinancials = Context.CanViewFinancials();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DentistDB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DentistDB.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar @(isSignedIn ? string.Empty : "d-none")">
            <a class="brand-mark" asp-controller="Home" asp-action="Index">
                <span class="brand-kicker">Klinik Yönetimi</span>
                <strong>DentistDB</strong>
                <small>Diş kliniği operasyon paneli</small>
            </a>

            <nav class="nav-cluster">
                <div class="nav-caption">Genel Bakış</div>
                <a class="nav-pill @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Kontrol Paneli</a>

                <div class="nav-caption">Hasta Yönetimi</div>
                <a class="nav-pill @(currentController == "Patients" && currentAction == "Index" ? "active" : "")" asp-controller="Patients" asp-action="Index">Tüm Hastalar</a>
                <a class="nav-pill @(currentController == "Patients" && currentAction == "Create" ? "active" : "")" asp-controller="Patients" asp-action="Create">Yeni Hasta</a>
                <a class="nav-pill @(currentController == "PreviousOperations" ? "active" : "")" asp-controller="PreviousOperations" asp-action="Index">Onceki Islemler</a>

                <div class="nav-caption">Takvim</div>
                <a class="nav-pill @(currentController == "Appointments" && currentAction == "Index" ? "active" : "")" asp-controller="Appointments" asp-action="Index">Randevular</a>
                <a class="nav-pill @(currentController == "Appointments" && currentAction == "Create" ? "active" : "")" asp-controller="Appointments" asp-action="Create">Randevu Oluştur</a>

                <div class="nav-caption">Finans</div>
                <a class="nav-pill @(currentController == "Billing" && currentAction == "Index" ? "active" : "")" asp-controller="Billing" asp-action="Index">Faturalar</a>
                <a class="nav-pill @(currentController == "Billing" && currentAction == "Create" ? "active" : "")" asp-controller="Billing" asp-action="Create">Fatura Oluştur</a>
            </nav>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <div>
                    <div class="topbar-eyebrow">DentistDB</div>
                    <h1 class="topbar-title">@ViewData["Title"]</h1>
                </div>
                <div class="topbar-actions">
                    @if (isSignedIn)
                    {
                        <div class="topbar-user">
                            <strong>@currentAccount!.Name</strong>
                            <span>@(canViewFinancials ? "Yönetici" : "Çalışan")</span>
                        </div>
                        <form asp-controller="Access" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light">Hesap Değiştir</button>
                        </form>
                    }
                </div>
            </header>

            <main class="content-stage @(isSignedIn ? string.Empty : "content-stage--wide")">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success shadow-sm border-0" role="alert">
                        @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger shadow-sm border-0" role="alert">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
