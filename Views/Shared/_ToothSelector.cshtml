@model IReadOnlyList<string>
@{
    var inputName = ViewData["InputName"] as string ?? "SelectedTeeth";
    var upperLeft = new[] { "18", "17", "16", "15", "14", "13", "12", "11" };
    var upperRight = new[] { "21", "22", "23", "24", "25", "26", "27", "28" };
    var lowerLeft = new[] { "48", "47", "46", "45", "44", "43", "42", "41" };
    var lowerRight = new[] { "31", "32", "33", "34", "35", "36", "37", "38" };
}

<div class="tooth-selector glass-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="eyebrow">Diş Seçimi</div>
            <div class="page-subtitle mt-1">İlgili dişleri işaretleyin.</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary js-clear-teeth">Temizle</button>
    </div>

    <div class="tooth-arch">
        <div class="tooth-column tooth-column--left">
            @foreach (var tooth in upperLeft)
            {
                var toothId = $"{inputName}-{tooth}";
                <input class="tooth-check" type="checkbox" id="@toothId" name="@inputName" value="@tooth" @(Model.Contains(tooth) ? "checked" : null) />
                <label class="tooth-node" for="@toothId">@tooth</label>
            }
        </div>
        <div class="tooth-arch__center">Üst Çene</div>
        <div class="tooth-column">
            @foreach (var tooth in upperRight)
            {
                var toothId = $"{inputName}-{tooth}";
                <input class="tooth-check" type="checkbox" id="@toothId" name="@inputName" value="@tooth" @(Model.Contains(tooth) ? "checked" : null) />
                <label class="tooth-node" for="@toothId">@tooth</label>
            }
        </div>
    </div>

    <div class="tooth-arch tooth-arch--lower mt-3">
        <div class="tooth-column tooth-column--left">
            @foreach (var tooth in lowerLeft)
            {
                var toothId = $"{inputName}-{tooth}";
                <input class="tooth-check" type="checkbox" id="@toothId" name="@inputName" value="@tooth" @(Model.Contains(tooth) ? "checked" : null) />
                <label class="tooth-node" for="@toothId">@tooth</label>
            }
        </div>
        <div class="tooth-arch__center">Alt Çene</div>
        <div class="tooth-column">
            @foreach (var tooth in lowerRight)
            {
                var toothId = $"{inputName}-{tooth}";
                <input class="tooth-check" type="checkbox" id="@toothId" name="@inputName" value="@tooth" @(Model.Contains(tooth) ? "checked" : null) />
                <label class="tooth-node" for="@toothId">@tooth</label>
            }
        </div>
    </div>
</div>
