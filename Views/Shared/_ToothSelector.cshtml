@model DentistDB.ViewModels.ToothSelectorViewModel

<div class="tooth-selector-card">
    <div class="tooth-selector-head">
        <div>
            <label class="form-label mb-0">@Model.Label</label>
            <div id="@Model.SummaryId" class="tooth-selector-summary">Diş seçilmedi</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group-seg btn-group-seg--sm">
                <button type="button" data-dentition="permanent" class="active" title="Kalıcı dişler (11–48)">Kalıcı</button>
                <button type="button" data-dentition="deciduous" title="Süt dişleri (51–85)">Süt</button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-tooth-clear>Temizle</button>
        </div>
    </div>

    <div class="tooth-selector-widget"
         data-tooth-selector
         data-svg-url="@Url.Content("~/images/teethSelection.svg")"
         data-input-id="@Model.InputId"
         data-summary-id="@Model.SummaryId"
         data-mode="multiple">
        <input type="hidden" id="@Model.InputId" name="@Model.InputName" value="@Model.SelectedTeethCsv" />

        <div class="tooth-selector-stage" data-tooth-stage>
            <div class="tooth-selector-loading">Diş şeması yükleniyor…</div>
        </div>

        <div class="tooth-selector-tools">
            <div class="chip-group" data-tooth-quick></div>
            <div class="tooth-typed">
                <input type="text" class="form-control form-control-sm num" data-tooth-typed placeholder="Numara yazın: 16, 17, 26" inputmode="numeric" autocomplete="off" aria-label="Diş numaraları" />
            </div>
            <div class="tooth-chips" data-tooth-chips></div>
        </div>
        <div class="form-text">Tıklayın veya sürükleyerek birden fazla diş seçin. Numaralar FDI sistemine göredir; hasta karşınızdaymış gibi sağ taraf solda görünür.</div>
    </div>
</div>

<script src="~/js/tooth-chart.js" asp-append-version="true" defer></script>
<script src="~/js/tooth-selector.js" asp-append-version="true" defer></script>
