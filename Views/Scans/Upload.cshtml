@model DentistDB.ViewModels.ScanUploadViewModel
@{
    ViewData["Title"] = "Görüntü Yükle";
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="scans">@Model.PatientName</a> / Görüntüler</div>
        <h2 class="page-title">Röntgen / Görüntü Yükle</h2>
    </div>
</div>

<div class="card content--narrow">
    <div class="card-body p-4">
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="PatientId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="File" class="form-label">Dosya <span class="req">*</span></label>
                    <input asp-for="File" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" required />
                    <div class="form-text">JPG, PNG, WebP veya PDF · en fazla 20 MB.</div>
                    <span asp-validation-for="File" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ScanType" class="form-label"></label>
                    <select asp-for="ScanType" asp-items="Html.GetEnumSelectList<ScanType>()" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ScanDate" class="form-label"></label>
                    <input asp-for="ScanDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
                    <span asp-validation-for="ScanDate" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Bulgular, hangi dişler, hekim yorumu…"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-upload"/></svg> Yükle</button>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="scans" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
