@model DentistDB.ViewModels.ScanUploadViewModel
@{
    ViewData["Title"] = "Upload Scan";
    var patientName = ViewBag.PatientName as string;
}

<div class="page-header">
    <h2>Upload Scan</h2>
    @if (!string.IsNullOrEmpty(patientName))
    {
        <p class="text-muted mb-0">For patient: <strong>@patientName</strong></p>
    }
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="PatientId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="File" class="form-label"></label>
                    <input asp-for="File" class="form-control" type="file"
                           accept=".jpg,.jpeg,.png,.pdf" />
                    <div class="form-text">Accepted formats: JPG, PNG, PDF. Max size: 20 MB.</div>
                    <span asp-validation-for="File" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ScanType" class="form-label"></label>
                    <select asp-for="ScanType" asp-items="Html.GetEnumSelectList<ScanType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ScanDate" class="form-label"></label>
                    <input asp-for="ScanDate" class="form-control" type="date" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Upload</button>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
