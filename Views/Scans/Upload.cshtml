@model DentistDB.ViewModels.ScanUploadViewModel
@{
    ViewData["Title"] = "Tarama Yukle";
    var patientName = ViewBag.PatientName as string;
}

<div class="page-header">
    <div>
        <div class="eyebrow">Goruntu Yukleme</div>
        <h2 class="page-title">Yeni tarama dosyasi ekleyin.</h2>
        @if (!string.IsNullOrEmpty(patientName))
        {
            <p class="page-subtitle">Hasta: <strong>@patientName</strong></p>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="PatientId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="File" class="form-label"></label>
                    <input asp-for="File" class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" />
                    <div class="form-text">Kabul edilen formatlar: JPG, PNG, PDF. Maksimum boyut: 20 MB.</div>
                    <span asp-validation-for="File" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ScanType" class="form-label"></label>
                    <select asp-for="ScanType" asp-items="Html.GetEnumSelectList<ScanType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ScanDate" class="form-label"></label>
                    <input asp-for="ScanDate" class="form-control" type="date" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Dosyayi Yukle</button>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary">Vazgec</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
