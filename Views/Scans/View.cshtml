@model DentistDB.Models.Scan
@{
    ViewData["Title"] = "Görüntü";
    var fileUrl = Url.Action("ContentFile", "Scans", new { id = Model.Id });
    var downloadUrl = Url.Action("ContentFile", "Scans", new { id = Model.Id, download = true });
    var isAdmin = Context.IsAdmin();
    var siblings = ViewBag.Siblings as System.Collections.IEnumerable;
    var scanLabel = $"{Model.ScanType.GetDisplayName()} · {Model.ScanDate.ToShortDate()}";

    // Other image scans of the same patient; offered in compare mode.
    var compareOptions = new List<(int Id, string Label, string Url)>();
    if (Model.IsImage && siblings != null)
    {
        foreach (dynamic s in siblings)
        {
            int siblingId = (int)s.Id;
            string siblingContentType = (string)s.ContentType;
            if (siblingId == Model.Id || !siblingContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            var label = $"{((ScanType)s.ScanType).GetDisplayName()} · {((DateOnly)s.ScanDate).ToShortDate()}";
            compareOptions.Add((siblingId, label, Url.Action("ContentFile", "Scans", new { id = siblingId }) ?? string.Empty));
        }
    }
}

@section Head {
    <link rel="stylesheet" href="~/css/scan-viewer.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="scans">@Model.Patient?.FullName</a> / Görüntüler</div>
        <h2 class="page-title">@Model.ScanType.GetDisplayName() <span class="badge-soft neutral ms-1">@Model.ScanDate.ToShortDate()</span></h2>
        <p class="page-subtitle">@Model.FileName · @Model.FileSizeDisplay</p>
    </div>
    <div class="page-actions">
        <a href="@fileUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary"><svg class="icon"><use href="#i-external"/></svg> Yeni Sekmede Aç</a>
        <a href="@downloadUrl" class="btn btn-outline-secondary"><svg class="icon"><use href="#i-download"/></svg> İndir</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><svg class="icon"><use href="#i-edit"/></svg> Bilgileri Düzenle</a>
        @if (isAdmin)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0" data-confirm="Bu görüntü kalıcı olarak silinsin mi?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger"><svg class="icon"><use href="#i-trash"/></svg> Sil</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-light mb-3"><svg class="icon"><use href="#i-info"/></svg><div><strong>Not:</strong> @Model.Notes</div></div>
}

@if (Model.IsImage)
{
    <div class="scan-viewer scan-viewer--image mb-3" data-scan-viewer data-label="@scanLabel">
        <div class="sv-toolbar" role="toolbar" aria-label="Görüntü araçları">
            <div class="sv-group">
                <button type="button" class="sv-btn" data-sv-action="zoom-out" title="Uzaklaştır (−)" aria-label="Uzaklaştır">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M8 11h6"/></svg>
                </button>
                <span class="sv-zoom" data-sv-zoom title="Yakınlaştırma oranı">100%</span>
                <button type="button" class="sv-btn" data-sv-action="zoom-in" title="Yaklaştır (+)" aria-label="Yaklaştır">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>
                </button>
                <button type="button" class="sv-btn" data-sv-action="fit" title="Ekrana sığdır (0)">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg><span class="sv-btn-text">Sığdır</span>
                </button>
                <button type="button" class="sv-btn" data-sv-action="actual" title="Gerçek boyut (%100)">1:1</button>
            </div>

            <div class="sv-group">
                <button type="button" class="sv-btn" data-sv-action="rotate-left" title="Sola döndür (Shift+R)" aria-label="Sola döndür">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v6h6"/></svg><span class="sv-btn-text">Sola döndür</span>
                </button>
                <button type="button" class="sv-btn" data-sv-action="rotate-right" title="Sağa döndür (R)" aria-label="Sağa döndür">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg><span class="sv-btn-text">Sağa döndür</span>
                </button>
                <button type="button" class="sv-btn" data-sv-action="flip" title="Yatay yansıt" aria-label="Yansıt">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18"/><path d="M8 7 3 12l5 5V7z"/><path d="m16 7 5 5-5 5V7z"/></svg><span class="sv-btn-text">Yansıt</span>
                </button>
            </div>

            <div class="sv-group">
                <label class="sv-slider" title="Parlaklık">
                    <span>Parlaklık</span>
                    <input type="range" min="25" max="200" step="1" value="100" data-sv-filter="brightness" aria-label="Parlaklık" />
                    <span class="sv-slider-val" data-sv-filter-val="brightness">100%</span>
                </label>
                <label class="sv-slider" title="Kontrast">
                    <span>Kontrast</span>
                    <input type="range" min="25" max="300" step="1" value="100" data-sv-filter="contrast" aria-label="Kontrast" />
                    <span class="sv-slider-val" data-sv-filter-val="contrast">100%</span>
                </label>
                <button type="button" class="sv-btn" data-sv-action="invert" aria-pressed="false" title="Negatif (renkleri ters çevir)">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>Negatif
                </button>
            </div>

            <div class="sv-spacer"></div>

            @if (compareOptions.Count > 0)
            {
                <div class="sv-group">
                    <label class="sv-label" for="svCompare">Karşılaştır</label>
                    <select id="svCompare" class="sv-select" data-sv-compare title="Aynı hastanın başka bir görüntüsüyle yan yana karşılaştır">
                        <option value="">Görüntü seçin…</option>
                        @foreach (var option in compareOptions)
                        {
                            <option value="@option.Id" data-src="@option.Url">@option.Label</option>
                        }
                    </select>
                </div>
            }

            <div class="sv-group">
                <button type="button" class="sv-btn" data-sv-action="reset" title="Yakınlaştırma, döndürme ve filtreleri sıfırla">Sıfırla</button>
            </div>
        </div>

        <div class="sv-panes">
            <div class="sv-pane is-active" data-sv-pane="primary">
                <div class="sv-pane-head">
                    <span class="sv-pane-title" data-sv-pane-title>@scanLabel</span>
                    <span class="sv-pane-zoom" data-sv-pane-zoom>100%</span>
                </div>
                <div class="sv-stage" data-sv-stage tabindex="0" aria-label="Görüntü alanı: @scanLabel">
                    <img class="sv-img" src="@fileUrl" alt="@Model.FileName" draggable="false" data-sv-img />
                    <div class="sv-status" data-sv-status>Yükleniyor…</div>
                    <noscript><div class="sv-status"><a href="@fileUrl" target="_blank" rel="noopener">Görüntüyü yeni sekmede aç</a></div></noscript>
                </div>
            </div>

            <div class="sv-pane" data-sv-pane="secondary" hidden>
                <div class="sv-pane-head">
                    <span class="sv-pane-title" data-sv-pane-title></span>
                    <span class="sv-pane-zoom" data-sv-pane-zoom>100%</span>
                    <button type="button" class="sv-btn sv-btn-sm" data-sv-action="compare-close" title="Karşılaştırmayı kapat (Esc)" aria-label="Karşılaştırmayı kapat"><svg class="icon"><use href="#i-x"/></svg></button>
                </div>
                <div class="sv-stage" data-sv-stage tabindex="0" aria-label="Karşılaştırılan görüntü">
                    <img class="sv-img" alt="" draggable="false" data-sv-img />
                    <div class="sv-status" data-sv-status>Yükleniyor…</div>
                </div>
            </div>
        </div>

        <div class="sv-footer">
            <div class="sv-compare-bar" data-sv-compare-bar hidden>
                <label class="sv-check"><input type="checkbox" data-sv-sync checked /> Senkron (yakınlaştırma ve kaydırma birlikte)</label>
                <button type="button" class="sv-btn sv-btn-sm" data-sv-action="compare-close"><svg class="icon"><use href="#i-x"/></svg> Karşılaştırmayı Kapat</button>
            </div>
            <div class="sv-hint">
                <kbd>Tekerlek</kbd> yaklaştır · <kbd>Sürükle</kbd> kaydır · <kbd>Çift tık</kbd> sığdır / 1:1 ·
                <kbd>+</kbd> <kbd>−</kbd> yaklaştır · <kbd>0</kbd> sığdır · <kbd>R</kbd> döndür · <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> kaydır · <kbd>Esc</kbd> karşılaştırmayı kapat
            </div>
        </div>
    </div>
}
else if (Model.IsPdf)
{
    <div class="scan-viewer mb-3">
        <iframe src="@fileUrl" title="@Model.FileName"></iframe>
    </div>
}
else
{
    <div class="scan-viewer mb-3">
        <p class="text-white-50 mb-0">Önizleme kullanılamıyor. Dosyayı indirerek inceleyebilirsiniz.</p>
    </div>
}

@if (siblings != null)
{
    <div class="scan-strip">
        @foreach (dynamic s in siblings)
        {
            bool isImage = ((string)s.ContentType).StartsWith("image/", StringComparison.OrdinalIgnoreCase);
            <a asp-action="View" asp-route-id="@s.Id" class="@(s.Id == Model.Id ? "active" : "")" title="@(((ScanType)s.ScanType).GetDisplayName()) · @(((DateOnly)s.ScanDate).ToShortDate())">
                @if (isImage)
                {
                    <img src="@Url.Action("ContentFile", "Scans", new { id = (int)s.Id })" alt="" loading="lazy" />
                }
                else
                {
                    <svg class="icon"><use href="#i-file"/></svg>
                }
            </a>
        }
    </div>
}

@section Scripts {
    @if (Model.IsImage)
    {
        <script src="~/js/scan-viewer.js" asp-append-version="true"></script>
    }
}
