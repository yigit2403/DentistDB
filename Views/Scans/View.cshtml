@model DentistDB.Models.Scan
@{
    ViewData["Title"] = "View Scan";
    var fileUrl = "~/" + Model.StoredPath.Replace("\\", "/");
    var isPdf = Model.ContentType == "application/pdf";
    var isImage = Model.ContentType.StartsWith("image/");
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2>🔬 Scan Viewer</h2>
        <p class="text-muted mb-0">
            @Model.Patient?.FullName &mdash;
            @Model.ScanDate.ToString("MMMM d, yyyy") &mdash;
            <span class="badge bg-info">@Model.ScanType</span>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Content(fileUrl)" download="@Model.FileName" class="btn btn-outline-primary">
            ⬇ Download
        </a>
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
           class="btn btn-outline-secondary">Back to Patient</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <div class="alert alert-light">
        <strong>Notes:</strong> @Model.Notes
    </div>
}

<div class="card">
    <div class="card-body text-center p-2">
        @if (isImage)
        {
            <img src="@Url.Content(fileUrl)" alt="@Model.FileName"
                 class="img-fluid rounded" style="max-height: 80vh;" />
        }
        else if (isPdf)
        {
            <iframe src="@Url.Content(fileUrl)" style="width:100%; height:80vh; border:none;"></iframe>
        }
        else
        {
            <p class="text-muted">Preview not available. <a href="@Url.Content(fileUrl)" download>Download file</a>.</p>
        }
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <form asp-controller="Scans" asp-action="Delete" asp-route-id="@Model.Id" method="post"
          onsubmit="return confirm('Delete this scan permanently?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger btn-sm">Delete Scan</button>
    </form>
</div>
