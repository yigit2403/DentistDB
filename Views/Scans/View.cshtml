@model DentistDB.Models.Scan
@{
    ViewData["Title"] = "Tarama İncele";
    var fileUrl = Url.Action("ContentFile", "Scans", new { id = Model.Id });
    var downloadUrl = Url.Action("ContentFile", "Scans", new { id = Model.Id, download = true });
    var isPdf = Model.ContentType == "application/pdf";
    var isImage = Model.ContentType.StartsWith("image/");
}

<div class="page-header">
    <div>
        <div class="eyebrow">Tarama Görüntüleyici</div>
        <h2 class="page-title">@Model.FileName</h2>
        <p class="page-subtitle">@Model.Patient?.FullName - @Model.ScanDate.ToString("D") - <span class="badge-soft info">@Model.ScanType.GetDisplayName()</span></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@downloadUrl" class="btn btn-outline-primary">İndir</a>
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary">Hasta Dosyasına Dön</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-light">
        <strong>Not:</strong> @Model.Notes
    </div>
}

<div class="card">
    <div class="card-body text-center p-3">
        @if (isImage)
        {
            <img src="@fileUrl" alt="@Model.FileName" class="img-fluid rounded" style="max-height: 80vh;" />
        }
        else if (isPdf)
        {
            <iframe src="@fileUrl" style="width:100%; height:80vh; border:none;"></iframe>
        }
        else
        {
            <p class="empty-state mb-0">Önizleme kullanılamıyor. Dosyayı indirerek inceleyebilirsiniz.</p>
        }
    </div>
</div>

<div class="mt-4">
    <form asp-controller="Scans" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu taramayı kalıcı olarak silmek istiyor musunuz?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Taramayı Sil</button>
    </form>
</div>
