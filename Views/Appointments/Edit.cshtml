@model DentistDB.ViewModels.AppointmentFormViewModel
@{
    ViewData["Title"] = "Randevu Düzenle";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Randevu Güncelleme</div>
        <h2 class="page-title">Plan bilgilerini düzenleyin.</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PatientId" class="form-label"></label>
                            <select asp-for="PatientId" asp-items="Model.Patients" class="form-select">
                                <option value="">Hasta seçin</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label"></label>
                            <div class="input-group bootstrap-picker">
                                <input asp-for="AppointmentDate" class="form-control js-picker" type="datetime-local" />
                                <button class="btn btn-outline-secondary js-picker-button" type="button" data-picker-target="AppointmentDate">Takvim</button>
                            </div>
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Purpose" class="form-label"></label>
                            <input asp-for="Purpose" class="form-control" list="purpose-options" placeholder="İsterseniz konu ekleyin" />
                            <datalist id="purpose-options">
                                @foreach (var purpose in Model.PurposeSuggestions)
                                {
                                    <option value="@purpose"></option>
                                }
                            </datalist>
                            <div class="quick-choice-group mt-2">
                                @foreach (var purpose in Model.PurposeSuggestions)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-quick-fill" data-target-id="Purpose" data-value="@purpose">@purpose</button>
                                }
                            </div>
                            <span asp-validation-for="Purpose" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12"><hr class="my-2" /></div>

                        <div class="col-md-12">
                            <label asp-for="InvoiceId" class="form-label"></label>
                            <select asp-for="InvoiceId" class="form-select" id="InvoiceId">
                                <option value="">Fatura seçin (isteğe bağlı)</option>
                                @foreach (var invoice in Model.Invoices)
                                {
                                    <option value="@invoice.Id" data-patient-id="@invoice.PatientId">@invoice.Label</option>
                                }
                            </select>
                            <div class="form-text">Randevuyu mevcut bir faturaya bağlayabilir veya alttan yeni bir fatura oluşturabilirsiniz.</div>
                            <span asp-validation-for="InvoiceId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check">
                                <input asp-for="CreateInvoice" class="form-check-input" type="checkbox" id="CreateInvoice" />
                                <label asp-for="CreateInvoice" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="col-12" id="new-invoice-panel">
                            <div class="card-subtle p-3">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="InvoiceDate" class="form-label"></label>
                                        <input asp-for="InvoiceDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="DueDate" class="form-label"></label>
                                        <input asp-for="DueDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="InvoiceTotalAmount" class="form-label"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">TL</span>
                                            <input asp-for="InvoiceTotalAmount" class="form-control" type="number" step="0.01" min="0.01" />
                                        </div>
                                        <span asp-validation-for="InvoiceTotalAmount" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="InvoiceNotes" class="form-label"></label>
                                        <textarea asp-for="InvoiceNotes" class="form-control" rows="2" placeholder="Fatura notları"></textarea>
                                        <span asp-validation-for="InvoiceNotes" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-check">
                                            <input asp-for="EnableInstallments" class="form-check-input" type="checkbox" id="EnableInstallments" />
                                            <label asp-for="EnableInstallments" class="form-check-label"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 installment-field">
                                        <label asp-for="FirstInstallmentDate" class="form-label"></label>
                                        <input asp-for="FirstInstallmentDate" class="form-control" type="date" />
                                        <span asp-validation-for="FirstInstallmentDate" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 installment-field">
                                        <label asp-for="InstallmentCount" class="form-label"></label>
                                        <input asp-for="InstallmentCount" class="form-control" type="number" min="1" max="48" />
                                        <span asp-validation-for="InstallmentCount" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 installment-field">
                                        <label asp-for="InstallmentIntervalMonths" class="form-label"></label>
                                        <input asp-for="InstallmentIntervalMonths" class="form-control" type="number" min="1" max="12" />
                                        <span asp-validation-for="InstallmentIntervalMonths" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    @{
                        await Html.RenderPartialAsync("_ToothSelector", new DentistDB.ViewModels.ToothSelectorViewModel
                        {
                            Label = "Diş Seçimi",
                            InputId = "SelectedTeeth",
                            InputName = "SelectedTeeth",
                            SummaryId = "SelectedTeethSummary",
                            SelectedTeethCsv = string.Join(",", Model.SelectedTeeth)
                        });
                    }
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (() => {
            const patientSelect = document.getElementById('PatientId');
            const invoiceSelect = document.getElementById('InvoiceId');
            const createInvoiceCheckbox = document.getElementById('CreateInvoice');
            const newInvoicePanel = document.getElementById('new-invoice-panel');
            const enableInstallmentsCheckbox = document.getElementById('EnableInstallments');
            const installmentFields = Array.from(document.querySelectorAll('.installment-field'));

            const filterInvoices = () => {
                const selectedPatientId = patientSelect?.value ?? '';
                const selectedInvoiceId = invoiceSelect?.value ?? '';
                let keepSelection = false;

                for (const option of invoiceSelect?.options ?? []) {
                    if (!option.value) {
                        continue;
                    }

                    const isMatch = !!selectedPatientId && option.dataset.patientId === selectedPatientId;
                    option.hidden = !isMatch;
                    option.disabled = !isMatch;

                    if (isMatch && option.value === selectedInvoiceId) {
                        keepSelection = true;
                    }
                }

                if (!keepSelection && invoiceSelect) {
                    invoiceSelect.value = '';
                }
            };

            const syncInvoicePanel = () => {
                const creating = !!createInvoiceCheckbox?.checked;
                if (newInvoicePanel) {
                    newInvoicePanel.style.display = creating ? '' : 'none';
                }
                if (invoiceSelect) {
                    invoiceSelect.disabled = creating;
                    if (creating) {
                        invoiceSelect.value = '';
                    }
                }
            };

            const syncInstallments = () => {
                const enabled = !!enableInstallmentsCheckbox?.checked;
                for (const field of installmentFields) {
                    field.style.display = enabled ? '' : 'none';
                }
            };

            patientSelect?.addEventListener('change', filterInvoices);
            createInvoiceCheckbox?.addEventListener('change', syncInvoicePanel);
            enableInstallmentsCheckbox?.addEventListener('change', syncInstallments);

            filterInvoices();
            syncInvoicePanel();
            syncInstallments();
        })();
    </script>
}
