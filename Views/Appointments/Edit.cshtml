@model DentistDB.ViewModels.AppointmentFormViewModel
@{
    ViewData["Title"] = "Randevu Düzenle";
    var isAdmin = Context.IsAdmin();
    var cancelUrl = Model.ReturnUrl ?? Url.Action("Index", new { date = Model.Date.ToString("yyyy-MM-dd") });
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">Randevular</a> / Düzenle</div>
        <h2 class="page-title">Randevu Düzenle@(Model.PatientName != null ? $" · {Model.PatientName}" : "")</h2>
    </div>
    <div class="page-actions">
        @if (Model.PatientId > 0)
        {
            <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary"><svg class="icon"><use href="#i-user"/></svg> Hasta Kartı</a>
        }
        @if (Model.Status == AppointmentStatus.Completed)
        {
            <partial name="_FollowUpMenu" model='new Appointment { Id = Model.Id, PatientId = Model.PatientId, AppointmentDate = Model.StartDateTime, Purpose = Model.Purpose ?? string.Empty, SelectedTeethData = Model.SelectedTeeth, DurationMinutes = Model.DurationMinutes }' view-data='new ViewDataDictionary(ViewData) { { "ReturnUrl", Model.ReturnUrl } }' />
        }
        @if ((int)(ViewBag.SeriesCount ?? 0) > 0)
        {
            <form asp-action="CancelSeries" asp-route-id="@Model.Id" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="m-0" data-confirm="Bu ve serideki sonraki randevular iptal edilsin mi?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger"><svg class="icon"><use href="#i-x"/></svg> Seriyi İptal Et (@ViewBag.SeriesCount)</button>
            </form>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-appointment-form data-conflicts-url="@Url.Action("Conflicts")" data-exclude-id="@Model.Id">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_AppointmentForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Değişiklikleri Kaydet</button>
                <a href="@cancelUrl" class="btn btn-outline-secondary">Vazgeç</a>
                @if (isAdmin)
                {
                    <button type="submit" form="delete-appointment" class="btn btn-outline-danger ms-auto"><svg class="icon"><use href="#i-trash"/></svg> Randevuyu Sil</button>
                }
            </div>
        </form>
        @if (isAdmin)
        {
            <form id="delete-appointment" asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnUrl="@Model.ReturnUrl" method="post" data-confirm="Randevu kalıcı olarak silinsin mi? İptal etmek için durum alanını kullanabilirsiniz.">
                @Html.AntiForgeryToken()
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-form.js" asp-append-version="true"></script>
}
