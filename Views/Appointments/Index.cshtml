@model DentistDB.ViewModels.AppointmentIndexViewModel
@{
    ViewData["Title"] = "Randevular";
    var isAdmin = Context.IsAdmin();
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var refIso = Model.ReferenceDate.ToString("yyyy-MM-dd");
    var statusRoute = Model.StatusFilter?.ToString();
    var dayNames = new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };
    var isTimeGrid = Model.CalendarView is AppointmentCalendarView.Daily or AppointmentCalendarView.Weekly;
    var grid = isTimeGrid ? TimeGridLayout.Create(Model.Appointments, Model.DayStart, Model.DayEnd) : null;

    string ViewLabel(AppointmentCalendarView view) => view switch
    {
        AppointmentCalendarView.Daily => "Gün",
        AppointmentCalendarView.Weekly => "Hafta",
        AppointmentCalendarView.Monthly => "Ay",
        AppointmentCalendarView.List => "Liste",
        _ => view.ToString()
    };

    string DayName(DateTime d) => dayNames[((int)d.DayOfWeek + 6) % 7];
    string SlotHref(DateTime slotStart) => Url.Action("Create", new { date = slotStart.ToString("yyyy-MM-ddTHH:mm"), returnUrl = currentUrl })!;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Randevular</h2>
        <p class="page-subtitle">
            @Model.PeriodLabel · @Model.TotalCount randevu
            @if (Model.PatientName != null)
            {
                <span class="badge-soft primary ms-1">@Model.PatientName <a asp-action="Index" asp-route-view="@Model.CalendarView" asp-route-date="@refIso" class="ms-1 text-decoration-none" title="Filtreyi kaldır" aria-label="Hasta filtresini kaldır">✕</a></span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a asp-action="PrintDay" asp-route-date="@refIso" target="_blank" class="btn btn-outline-secondary" title="Günlük listeyi yazdır"><svg class="icon"><use href="#i-print"/></svg> Günlük Liste</a>
        <a asp-action="Create" asp-route-date="@Model.ReferenceDate.ToString("yyyy-MM-ddTHH:mm")" asp-route-patientId="@Model.PatientId" asp-route-returnUrl="@currentUrl" class="btn btn-primary" data-shortcut-new><svg class="icon"><use href="#i-calendar-plus"/></svg> Yeni Randevu</a>
    </div>
</div>

<div class="cal-toolbar">
    <div class="cal-nav">
        <a asp-action="Index" asp-route-view="@Model.CalendarView" asp-route-status="@statusRoute" asp-route-patientId="@Model.PatientId" asp-route-date="@Model.PreviousDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-icon" title="Önceki" aria-label="Önceki dönem"><svg class="icon"><use href="#i-chevron-left"/></svg></a>
        <a asp-action="Index" asp-route-view="@Model.CalendarView" asp-route-status="@statusRoute" asp-route-patientId="@Model.PatientId" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Bugün</a>
        <a asp-action="Index" asp-route-view="@Model.CalendarView" asp-route-status="@statusRoute" asp-route-patientId="@Model.PatientId" asp-route-date="@Model.NextDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-icon" title="Sonraki" aria-label="Sonraki dönem"><svg class="icon"><use href="#i-chevron-right"/></svg></a>
    </div>

    <form method="get" class="d-inline-flex align-items-center gap-2">
        <input type="hidden" name="view" value="@Model.CalendarView" />
        <input type="hidden" name="status" value="@statusRoute" />
        <input type="hidden" name="patientId" value="@Model.PatientId" />
        <label for="calDate" class="visually-hidden">Tarih</label>
        <input type="date" id="calDate" name="date" value="@refIso" class="form-control" style="width:160px" data-autosubmit />
    </form>

    <div class="btn-group-seg" role="group" aria-label="Görünüm">
        @foreach (var view in Enum.GetValues<AppointmentCalendarView>())
        {
            <a asp-action="Index" asp-route-view="@view" asp-route-status="@statusRoute" asp-route-patientId="@Model.PatientId" asp-route-date="@refIso" class="@(Model.CalendarView == view ? "active" : "")" aria-current="@(Model.CalendarView == view ? "page" : null)">@ViewLabel(view)</a>
        }
    </div>

    <form method="get" class="d-inline-flex align-items-center gap-2 ms-auto">
        <input type="hidden" name="view" value="@Model.CalendarView" />
        <input type="hidden" name="date" value="@refIso" />
        <input type="hidden" name="patientId" value="@Model.PatientId" />
        <label for="calStatus" class="visually-hidden">Durum filtresi</label>
        <select id="calStatus" name="status" class="form-select" style="width:180px" data-autosubmit>
            <option value="">Tüm durumlar</option>
            @foreach (var status in Enum.GetValues<AppointmentStatus>())
            {
                <option value="@status" selected="@(Model.StatusFilter == status)">@status.GetDisplayName()</option>
            }
        </select>
    </form>
</div>

@if (isTimeGrid && grid != null)
{
    var isDaily = Model.CalendarView == AppointmentCalendarView.Daily;
    var days = isDaily ? Model.Days.Take(1).ToList() : Model.Days.ToList();

    <div class="tg-scroll">
        <div class="tg @(isDaily ? "tg--day" : "tg--week")"
             style="--tg-rows:@grid.RowCount; --tg-cols:@days.Count;"
             data-time-grid
             data-start-minutes="@((int)grid.Start.TotalMinutes)"
             data-slot-minutes="@grid.SlotMinutes"
             role="grid"
             aria-label="@(isDaily ? "Günlük randevu çizelgesi" : "Haftalık randevu çizelgesi")">
            <div class="tg-corner" aria-hidden="true"></div>
            @foreach (var d in days)
            {
                var dayIso = d.Date.ToString("yyyy-MM-dd");
                <div class="tg-head @(d.IsToday ? "is-today" : "") @(d.IsWeekend ? "is-weekend" : "")">
                    @if (isDaily)
                    {
                        <span class="tg-head-name">@d.Date.ToDayHeading()</span>
                        <span class="tg-head-count">@d.Appointments.Count(a => a.Status != AppointmentStatus.Cancelled) randevu</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-view="Daily" asp-route-status="@statusRoute" asp-route-patientId="@Model.PatientId" asp-route-date="@dayIso" class="tg-head-link" title="@d.Date.ToDayHeading()">
                            <span class="tg-head-name">@DayName(d.Date)</span>
                            <span class="tg-head-day">@d.Date.Day</span>
                        </a>
                        @if (d.Appointments.Count > 0)
                        {
                            <span class="tg-head-count">@d.Appointments.Count</span>
                        }
                    }
                </div>
            }

            <div class="tg-axis" aria-hidden="true">
                @foreach (var hour in grid.Hours)
                {
                    <span class="tg-hour" style="grid-row:@hour.RowStart / span @hour.RowSpan">@hour.Label</span>
                }
            </div>

            @foreach (var d in days)
            {
                var placements = grid.Place(d.Appointments);
                var lanes = placements.Count == 0 ? 1 : placements.Max(p => p.LaneCount);
                var dayIso = d.Date.ToString("yyyy-MM-dd");

                <div class="tg-day @(d.IsToday ? "is-today" : "") @(d.IsWeekend ? "is-weekend" : "")" data-tg-day="@dayIso" data-lanes="@lanes" role="row">
                    @for (var row = 1; row <= grid.RowCount; row++)
                    {
                        var slotStart = grid.SlotStart(d.Date, row);
                        var label = $"{slotStart:HH:mm} · {d.Date:d MMMM} randevu ekle";
                        <a class="tg-slot @(grid.IsHourRow(row) ? "is-hour" : "") @(grid.IsWorkingRow(row) ? "" : "is-off")"
                           style="grid-row:@row"
                           href="@SlotHref(slotStart)"
                           title="@label"
                           aria-label="@label"
                           role="gridcell"></a>
                    }

                    @foreach (var p in placements)
                    {
                        var a = p.Appointment;
                        var teeth = TeethSelectionSerializer.Parse(a.SelectedTeethData);
                        // Day columns have 12 lane tracks; an overlap cluster of C lanes splits them evenly,
                        // so an appointment with nothing beside it still spans the whole column.
                        var laneWidth = Math.Max(1, TimeGridLayout.LaneTracks / p.LaneCount);
                        var laneStart = p.Lane * laneWidth + 1;
                        var style = $"grid-row:{p.RowStart} / span {p.RowSpan}; grid-column:{laneStart} / span {laneWidth}";
                        var summary = $"{a.AppointmentDate.ToTimeText()}–{a.EndDate.ToTimeText()} · {a.Patient?.FullName} · {a.Purpose} · {a.Status.GetDisplayName()}";

                        if (isDaily)
                        {
                            <article class="tg-event tg-event--full status-@a.Status @(p.IsShort ? "is-short" : "") @(p.RowSpan <= 2 ? "is-compact" : "") @(p.LaneCount > 1 ? "is-narrow" : "")" style="@style" aria-label="@summary" role="gridcell">
                                <div class="tg-event-main">
                                    <div class="tg-event-line">
                                        <span class="tg-event-time">@a.AppointmentDate.ToTimeText()–@a.EndDate.ToTimeText()</span>
                                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@a.PatientId" class="tg-event-name">@a.Patient?.FullName</a>
                                        @if (a.Patient?.HasMedicalRisk == true)
                                        {
                                            <span class="badge-soft danger" title="@string.Join(", ", a.Patient.RiskFlags)">Tıbbi Uyarı</span>
                                        }
                                        @if (a.Status != AppointmentStatus.Scheduled)
                                        {
                                            <span class="badge-soft @a.Status.ToBadgeClass()">@a.Status.GetDisplayName()</span>
                                        }
                                        <span class="tg-event-purpose">@a.Purpose</span>
                                    </div>
                                    <div class="tg-event-sub">
                                        @a.DurationMinutes.ToDurationText()
                                        @if (teeth.Any())
                                        {
                                            <span class="tooth-chips ms-1">@foreach (var t in teeth) { <span class="tooth-chip">@t</span> }</span>
                                        }
                                        @if (!string.IsNullOrEmpty(a.Patient?.Phone))
                                        {
                                            <span class="text-faint"> · @a.Patient.Phone.FormatPhone()</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(a.Notes))
                                        {
                                            <span class="text-muted"> · @a.Notes</span>
                                        }
                                    </div>
                                </div>
                                <div class="tg-event-actions">
                                    @if (a.Status == AppointmentStatus.Scheduled)
                                    {
                                        <form asp-action="SetStatus" asp-route-id="@a.Id" asp-route-status="Completed" asp-route-returnUrl="@currentUrl" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Tamamlandı olarak işaretle"><svg class="icon"><use href="#i-check"/></svg><span class="tg-btn-text"> Tamamlandı</span></button>
                                        </form>
                                        <form asp-action="SetStatus" asp-route-id="@a.Id" asp-route-status="NoShow" asp-route-returnUrl="@currentUrl" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Gelmedi olarak işaretle"><svg class="icon"><use href="#i-x"/></svg><span class="tg-btn-text"> Gelmedi</span></button>
                                        </form>
                                        <form asp-action="SetStatus" asp-route-id="@a.Id" asp-route-status="Cancelled" asp-route-returnUrl="@currentUrl" method="post" class="m-0" data-confirm="Bu randevu iptal edilsin mi?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Randevuyu iptal et"><svg class="icon" aria-hidden="true"><use href="#i-ban"/></svg><span class="tg-btn-text"> İptal</span></button>
                                        </form>
                                    }
                                    else
                                    {
                                        @if (a.Status == AppointmentStatus.Completed)
                                        {
                                            <partial name="_FollowUpMenu" model="a" view-data='new ViewDataDictionary(ViewData) { { "ReturnUrl", currentUrl } }' />
                                        }
                                        <form asp-action="SetStatus" asp-route-id="@a.Id" asp-route-status="Scheduled" asp-route-returnUrl="@currentUrl" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Planlandı durumuna geri al"><svg class="icon"><use href="#i-refresh"/></svg><span class="tg-btn-text"> Geri Al</span></button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@a.Id" asp-route-returnUrl="@currentUrl" class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="Randevuyu düzenle"><svg class="icon"><use href="#i-edit"/></svg></a>
                                    @if (isAdmin)
                                    {
                                        <form asp-action="Delete" asp-route-id="@a.Id" asp-route-returnUrl="@currentUrl" method="post" class="m-0" data-confirm="Randevu kalıcı olarak silinsin mi?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="Sil" aria-label="Randevuyu sil"><svg class="icon"><use href="#i-trash"/></svg></button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@a.Id" asp-route-returnUrl="@currentUrl"
                               class="tg-event status-@a.Status @(p.IsShort ? "is-short" : "")"
                               style="@style" title="@summary" aria-label="@summary" role="gridcell">
                                <span class="tg-event-line"><strong>@a.AppointmentDate.ToTimeText()</strong> @a.Patient?.FullName</span>
                                <span class="tg-event-sub">@a.Purpose · @a.DurationMinutes.ToDurationText()</span>
                            </a>
                        }
                    }

                    @if (d.IsToday)
                    {
                        <div class="tg-now" data-tg-now hidden aria-hidden="true"><span class="tg-now-label" data-tg-now-label></span></div>
                    }
                </div>
            }
        </div>
    </div>
    <p class="text-faint small mt-2 no-print">Boş bir saate tıklayarak o saate randevu ekleyin. Çalışma saatleri dışı gri gösterilir.</p>
}
else if (Model.CalendarView == AppointmentCalendarView.Monthly)
{
    <div class="cal-grid">
        @foreach (var name in dayNames)
        {
            <div class="cal-head">@name</div>
        }
        @foreach (var d in Model.Days)
        {
            <div class="cal-cell @(d.IsToday ? "is-today" : "") @(!d.IsCurrentPeriod ? "is-other" : "") @(d.IsWeekend ? "is-weekend" : "")">
                <div class="cal-cell-head">
                    <a asp-action="Index" asp-route-view="Daily" asp-route-date="@d.Date.ToString("yyyy-MM-dd")" class="cal-day" aria-label="@d.Date.ToDayHeading()">@d.Date.Day</a>
                    @if (d.Appointments.Count > 0)
                    {
                        <span class="cal-count">@d.Appointments.Count</span>
                    }
                    else
                    {
                        <a asp-action="Create" asp-route-date="@d.Date.Add(Model.DayStart.ToTimeSpan()).ToString("yyyy-MM-ddTHH:mm")" asp-route-returnUrl="@currentUrl" class="add" title="Randevu ekle" aria-label="@d.Date.ToDayHeading() için randevu ekle"><svg class="icon"><use href="#i-plus"/></svg></a>
                    }
                </div>
                @foreach (var a in d.Appointments.Take(3))
                {
                    <a asp-action="Edit" asp-route-id="@a.Id" asp-route-returnUrl="@currentUrl" class="cal-chip status-@a.Status" title="@a.Patient?.FullName · @a.Purpose"><strong>@a.AppointmentDate.ToTimeText()</strong>@a.Patient?.FullName</a>
                }
                @if (d.Appointments.Count > 3)
                {
                    <a asp-action="Index" asp-route-view="Daily" asp-route-date="@d.Date.ToString("yyyy-MM-dd")" class="cal-more">+@(d.Appointments.Count - 3) daha</a>
                }
            </div>
        }
    </div>
}
else
{
    <div class="card">
        @if (!Model.Appointments.Any())
        {
            <div class="empty-state"><svg class="icon"><use href="#i-calendar"/></svg><p>Bu aralıkta randevu yok.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead><tr><th>Tarih</th><th>Saat</th><th>Hasta</th><th>Neden</th><th>Süre</th><th>Durum</th><th class="row-actions"></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Appointments)
                        {
                            <tr data-href="@Url.Action("Edit", new { id = a.Id, returnUrl = currentUrl })">
                                <td>@a.AppointmentDate.ToShortDate() <span class="sub">@a.AppointmentDate.ToString("dddd")</span></td>
                                <td class="num">@a.AppointmentDate.ToTimeText()</td>
                                <td>
                                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@a.PatientId" class="row-link">@a.Patient?.FullName</a>
                                    @if (!string.IsNullOrEmpty(a.Patient?.Phone)) { <span class="sub num">@a.Patient.Phone.FormatPhone()</span> }
                                </td>
                                <td>@a.Purpose</td>
                                <td>@a.DurationMinutes.ToDurationText()</td>
                                <td><span class="badge-soft @a.Status.ToBadgeClass()">@a.Status.GetDisplayName()</span></td>
                                <td class="row-actions"><a asp-action="Edit" asp-route-id="@a.Id" asp-route-returnUrl="@currentUrl" class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="Randevuyu düzenle"><svg class="icon"><use href="#i-edit"/></svg></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<div class="text-faint small mt-3 no-print">Kısayollar: <kbd>N</kbd> yeni randevu · <kbd>←</kbd> <kbd>→</kbd> önceki / sonraki · <kbd>T</kbd> bugün · <kbd>G</kbd> gün · <kbd>H</kbd> hafta · <kbd>A</kbd> ay · <kbd>L</kbd> liste · <kbd>P</kbd> yazdır</div>

@section Scripts {
    <script>
        (function () {
            // Serialised as JSON so query-string ampersands are not HTML-encoded inside the script.
            var links = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                prev = Url.Action("Index", new { view = Model.CalendarView, status = statusRoute, patientId = Model.PatientId, date = Model.PreviousDate.ToString("yyyy-MM-dd") }),
                next = Url.Action("Index", new { view = Model.CalendarView, status = statusRoute, patientId = Model.PatientId, date = Model.NextDate.ToString("yyyy-MM-dd") }),
                today = Url.Action("Index", new { view = Model.CalendarView, status = statusRoute, patientId = Model.PatientId }),
                g = Url.Action("Index", new { view = "Daily", status = statusRoute, patientId = Model.PatientId, date = refIso }),
                h = Url.Action("Index", new { view = "Weekly", status = statusRoute, patientId = Model.PatientId, date = refIso }),
                a = Url.Action("Index", new { view = "Monthly", status = statusRoute, patientId = Model.PatientId, date = refIso }),
                l = Url.Action("Index", new { view = "List", status = statusRoute, patientId = Model.PatientId, date = refIso }),
                print = Url.Action("PrintDay", new { date = refIso })
            }));
            document.addEventListener("keydown", function (e) {
                var tag = (document.activeElement && document.activeElement.tagName || "").toLowerCase();
                if (tag === "input" || tag === "textarea" || tag === "select" || e.ctrlKey || e.altKey || e.metaKey) return;
                var key = e.key.toLowerCase();
                var go = function (url) { e.preventDefault(); window.location.href = url; };
                if (key === "n") { var btn = document.querySelector("[data-shortcut-new]"); if (btn) go(btn.href); }
                else if (key === "arrowleft") go(links.prev);
                else if (key === "arrowright") go(links.next);
                else if (key === "t") go(links.today);
                else if (key === "g") go(links.g);
                else if (key === "h") go(links.h);
                else if (key === "a") go(links.a);
                else if (key === "l") go(links.l);
                else if (key === "p") { e.preventDefault(); window.open(links.print, "_blank"); }
            });

            // Current-time line on today's column of the time grid.
            var grid = document.querySelector("[data-time-grid]");
            var now = grid && grid.querySelector("[data-tg-now]");
            if (grid && now) {
                var startMinutes = Number(grid.dataset.startMinutes);
                var slotMinutes = Number(grid.dataset.slotMinutes) || 15;
                var label = now.querySelector("[data-tg-now-label]");
                var update = function () {
                    var column = now.parentElement;
                    var slotH = parseFloat(getComputedStyle(column).getPropertyValue("--tg-slot-h"));
                    var rows = Number(grid.style.getPropertyValue("--tg-rows")) || 0;
                    var d = new Date();
                    var minutes = d.getHours() * 60 + d.getMinutes() - startMinutes;
                    var total = rows * slotMinutes;
                    if (!slotH || minutes < 0 || minutes > total) { now.hidden = true; return; }
                    now.style.top = (minutes / slotMinutes * slotH) + "px";
                    if (label) label.textContent = String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
                    now.hidden = false;
                };
                update();
                window.setInterval(update, 60000);
            }
        })();
    </script>
}
