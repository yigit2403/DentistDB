@using System.Text.Json
@model DentistDB.ViewModels.AppointmentFormViewModel
@{
    ViewData["Title"] = "Yeni Randevu";
    var financeJson = JsonSerializer.Serialize(Model.PatientFinances);
}

<div class="page-header">
    <div>
        <div class="eyebrow">Randevu Oluştur</div>
        <h2 class="page-title">Takvime yeni bir ziyaret ekleyin.</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="PatientMode" class="form-label"></label>
                            <select asp-for="PatientMode" class="form-select" id="PatientMode">
                                <option value="@AppointmentPatientMode.Existing">Kayıtlı hasta</option>
                                <option value="@AppointmentPatientMode.New">Yeni hasta oluştur</option>
                            </select>
                        </div>

                        <div class="col-12" id="existing-patient-panel">
                            <label asp-for="PatientId" class="form-label"></label>
                            <select asp-for="PatientId" asp-items="Model.Patients" class="form-select" id="PatientId">
                                <option value="">Hasta seçin</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger small"></span>
                        </div>

                        <div class="col-12" id="new-patient-panel">
                            <div class="card-subtle p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="NewPatient.FullName" class="form-label"></label>
                                        <input asp-for="NewPatient.FullName" class="form-control" />
                                        <span asp-validation-for="NewPatient.FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewPatient.Phone" class="form-label"></label>
                                        <input asp-for="NewPatient.Phone" class="form-control" />
                                        <span asp-validation-for="NewPatient.Phone" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="NewPatient.Tckn" class="form-label"></label>
                                        <input asp-for="NewPatient.Tckn" class="form-control" maxlength="11" inputmode="numeric" />
                                        <span asp-validation-for="NewPatient.Tckn" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewPatient.Email" class="form-label"></label>
                                        <input asp-for="NewPatient.Email" class="form-control" />
                                        <span asp-validation-for="NewPatient.Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewPatient.BirthDate" class="form-label"></label>
                                        <input asp-for="NewPatient.BirthDate" class="form-control" type="date" />
                                        <span asp-validation-for="NewPatient.BirthDate" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewPatient.Address" class="form-label"></label>
                                        <input asp-for="NewPatient.Address" class="form-control" />
                                        <span asp-validation-for="NewPatient.Address" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="NewPatient.MedicalAlerts" class="form-label"></label>
                                        <input asp-for="NewPatient.MedicalAlerts" class="form-control" />
                                        <span asp-validation-for="NewPatient.MedicalAlerts" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="NewPatient.Notes" class="form-label"></label>
                                        <textarea asp-for="NewPatient.Notes" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="NewPatient.Notes" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label"></label>
                            <div class="input-group bootstrap-picker">
                                <input asp-for="AppointmentDate" class="form-control js-picker" type="datetime-local" />
                                <button class="btn btn-outline-secondary js-picker-button" type="button" data-picker-target="AppointmentDate">Takvim</button>
                            </div>
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Purpose" class="form-label"></label>
                            <input asp-for="Purpose" class="form-control" list="purpose-options" placeholder="İsterseniz konu ekleyin" />
                            <datalist id="purpose-options">
                                @foreach (var purpose in Model.PurposeSuggestions)
                                {
                                    <option value="@purpose"></option>
                                }
                            </datalist>
                            <div class="quick-choice-group mt-2">
                                @foreach (var purpose in Model.PurposeSuggestions)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-quick-fill" data-target-id="Purpose" data-value="@purpose">@purpose</button>
                                }
                            </div>
                            <span asp-validation-for="Purpose" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Randevu notları, hazırlık talepleri veya açıklamalar"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12"><hr class="my-2" /></div>

                        <div class="col-12">
                            <div class="card-subtle p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="FinanceMode" class="form-label"></label>
                                        <select asp-for="FinanceMode" class="form-select" id="FinanceMode">
                                            <option value="@AppointmentFinanceMode.None">Finans işlemi yapma</option>
                                            <option value="@AppointmentFinanceMode.PayInFull">Borcu hemen tahsil et</option>
                                            <option value="@AppointmentFinanceMode.Installments">Borcu taksitlendir</option>
                                        </select>
                                    </div>
                                    <div class="col-12" id="patient-finance-summary"></div>
                                    <div class="col-12" id="finance-panel">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label asp-for="ChargeAmount" class="form-label"></label>
                                                <div class="input-group">
                                                    <span class="input-group-text">TL</span>
                                                    <input asp-for="ChargeAmount" class="form-control" type="number" step="0.01" min="0.01" />
                                                </div>
                                                <span asp-validation-for="ChargeAmount" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label asp-for="InvoiceDate" class="form-label"></label>
                                                <input asp-for="InvoiceDate" class="form-control" type="date" />
                                            </div>
                                            <div class="col-md-4">
                                                <label asp-for="DueDate" class="form-label"></label>
                                                <input asp-for="DueDate" class="form-control" type="date" />
                                            </div>
                                            <div class="col-md-12">
                                                <label asp-for="InvoiceNotes" class="form-label"></label>
                                                <textarea asp-for="InvoiceNotes" class="form-control" rows="2" placeholder="Finans notları"></textarea>
                                                <span asp-validation-for="InvoiceNotes" class="text-danger small"></span>
                                            </div>

                                            <div class="col-12" id="pay-in-full-panel">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label asp-for="PaymentMethod" class="form-label"></label>
                                                        <select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label asp-for="PaymentNotes" class="form-label"></label>
                                                        <input asp-for="PaymentNotes" class="form-control" />
                                                        <span asp-validation-for="PaymentNotes" class="text-danger small"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-12" id="installment-panel">
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <label asp-for="FirstInstallmentDate" class="form-label"></label>
                                                        <input asp-for="FirstInstallmentDate" class="form-control" type="date" />
                                                        <span asp-validation-for="FirstInstallmentDate" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label asp-for="InstallmentCount" class="form-label"></label>
                                                        <input asp-for="InstallmentCount" class="form-control" type="number" min="1" max="48" />
                                                        <span asp-validation-for="InstallmentCount" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label asp-for="InstallmentIntervalMonths" class="form-label"></label>
                                                        <input asp-for="InstallmentIntervalMonths" class="form-control" type="number" min="1" max="12" />
                                                        <span asp-validation-for="InstallmentIntervalMonths" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-md-12" id="installment-merge-panel">
                                                        <label asp-for="InstallmentMergeMode" class="form-label"></label>
                                                        <select asp-for="InstallmentMergeMode" class="form-select">
                                                            <option value="">Yöntem seçin</option>
                                                            <option value="@InstallmentMergeMode.SpreadOverCurrentDates">Mevcut taksit tarihlerine yay</option>
                                                            <option value="@InstallmentMergeMode.AppendAfterCurrentSchedule">Mevcut taksitlerden sonra ekle</option>
                                                        </select>
                                                        <span asp-validation-for="InstallmentMergeMode" class="text-danger small"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    @{
                        await Html.RenderPartialAsync("_ToothSelector", new DentistDB.ViewModels.ToothSelectorViewModel
                        {
                            Label = "Diş Seçimi",
                            InputId = "SelectedTeeth",
                            InputName = "SelectedTeeth",
                            SummaryId = "SelectedTeethSummary",
                            SelectedTeethCsv = string.Join(",", Model.SelectedTeeth)
                        });
                    }
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Randevuyu Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (() => {
            const financeLookup = new Map((@Html.Raw(financeJson)).map(item => [String(item.patientId), item]));
            const patientMode = document.getElementById('PatientMode');
            const patientSelect = document.getElementById('PatientId');
            const financeMode = document.getElementById('FinanceMode');
            const existingPatientPanel = document.getElementById('existing-patient-panel');
            const newPatientPanel = document.getElementById('new-patient-panel');
            const financePanel = document.getElementById('finance-panel');
            const payInFullPanel = document.getElementById('pay-in-full-panel');
            const installmentPanel = document.getElementById('installment-panel');
            const mergePanel = document.getElementById('installment-merge-panel');
            const summaryPanel = document.getElementById('patient-finance-summary');

            const getSelectedFinance = () => {
                if (!patientMode || patientMode.value !== '@AppointmentPatientMode.Existing') {
                    return null;
                }

                return financeLookup.get(patientSelect?.value ?? '') ?? null;
            };

            const syncPatientMode = () => {
                const isNewPatient = patientMode?.value === '@AppointmentPatientMode.New';
                if (existingPatientPanel) {
                    existingPatientPanel.style.display = isNewPatient ? 'none' : '';
                }
                if (newPatientPanel) {
                    newPatientPanel.style.display = isNewPatient ? '' : 'none';
                }
            };

            const syncFinancePanels = () => {
                const mode = financeMode?.value ?? '@AppointmentFinanceMode.None';
                const finance = getSelectedFinance();

                if (summaryPanel) {
                    if (finance) {
                        summaryPanel.innerHTML = `<div class="alert alert-info mb-0">Mevcut finans hesabı: kalan bakiye ${finance.balance.toFixed(2)} TL, bekleyen taksit ${finance.unpaidInstallmentCount} adet.</div>`;
                    } else {
                        summaryPanel.innerHTML = '';
                    }
                }

                if (financePanel) {
                    financePanel.style.display = mode === '@AppointmentFinanceMode.None' ? 'none' : '';
                }
                if (payInFullPanel) {
                    payInFullPanel.style.display = mode === '@AppointmentFinanceMode.PayInFull' ? '' : 'none';
                }
                if (installmentPanel) {
                    installmentPanel.style.display = mode === '@AppointmentFinanceMode.Installments' ? '' : 'none';
                }
                if (mergePanel) {
                    const showMerge = mode === '@AppointmentFinanceMode.Installments' && !!finance && finance.unpaidInstallmentCount > 0;
                    mergePanel.style.display = showMerge ? '' : 'none';
                }
            };

            patientMode?.addEventListener('change', () => {
                syncPatientMode();
                syncFinancePanels();
            });

            patientSelect?.addEventListener('change', syncFinancePanels);
            financeMode?.addEventListener('change', syncFinancePanels);

            syncPatientMode();
            syncFinancePanels();
        })();
    </script>
}
