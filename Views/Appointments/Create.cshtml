@model DentistDB.ViewModels.AppointmentFormViewModel
@{
    ViewData["Title"] = "Yeni Randevu";
    var cancelUrl = Model.ReturnUrl ?? Url.Action("Index", new { date = Model.Date.ToString("yyyy-MM-dd") });
}

<div class="page-header">
    <div>
        <div class="topbar-crumb"><a asp-action="Index">Randevular</a> / Yeni</div>
        <h2 class="page-title">Yeni Randevu@(Model.PatientName != null ? $" · {Model.PatientName}" : "")</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" data-appointment-form data-conflicts-url="@Url.Action("Conflicts")">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_AppointmentForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-check"/></svg> Randevuyu Kaydet</button>
                <a href="@cancelUrl" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-form.js" asp-append-version="true"></script>
}
